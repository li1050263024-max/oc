.quota-sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10050;
}

.quota-sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.quota-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 42vh;
  padding: 18px 18px 28px;
  padding-bottom: calc(28px + constant(safe-area-inset-bottom));
  padding-bottom: calc(28px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #faf8ff 0%, #f3effc 100%);
  border-radius: 20px 20px 0 0;
  border-top: 1px solid rgba(139, 92, 246, 0.16);
  box-shadow: 0 -10px 32px rgba(109, 40, 217, 0.12);
  box-sizing: border-box;
}

.quota-sheet-handle {
  width: 36px;
  height: 4px;
  margin: 4px auto 18px;
  border-radius: 999px;
  background: rgba(109, 40, 217, 0.22);
}

.quota-sheet-title {
  display: block;
  font-size: 18px;
  font-weight: 650;
  color: #374151;
  margin-bottom: 8px;
}

.quota-sheet-sub {
  display: block;
  font-size: 13px;
  line-height: 1.5;
  color: #7c7c8a;
  margin-bottom: 20px;
}

.quota-sheet-btn {
  margin-top: 14px;
  padding: 18px 14px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(139, 92, 246, 0.16);
  box-shadow: 0 2px 8px rgba(109, 40, 217, 0.06);
  text-align: center;
}

.quota-sheet-btn--ok {
  background: linear-gradient(
    135deg,
    rgba(233, 224, 255, 0.95) 0%,
    rgba(255, 255, 255, 0.98) 100%
  );
  border-color: rgba(139, 92, 246, 0.28);
}

.quota-sheet-btn--ok .quota-sheet-btn-t {
  color: #6d28d9;
  font-weight: 600;
}

.quota-sheet-btn--primary {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  border-color: transparent;
  box-shadow: 0 6px 16px rgba(139, 92, 246, 0.28);
}

.quota-sheet-btn--primary .quota-sheet-btn-t {
  color: #ffffff;
  font-weight: 600;
}

.quota-sheet-btn--ghost {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(139, 92, 246, 0.16);
  box-shadow: 0 2px 8px rgba(109, 40, 217, 0.06);
  margin-top: 14px;
  padding: 18px 14px;
}

.quota-sheet-btn--ghost .quota-sheet-btn-t {
  color: #374151;
  font-size: 15px;
  font-weight: 500;
}

.quota-sheet-btn--disabled {
  opacity: 0.45;
}

.quota-sheet-btn-t {
  font-size: 15px;
  color: #374151;
}

.quota-oa-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(76, 48, 140, 0.38);
}

.quota-oa-box {
  width: 100%;
  max-width: 320px;
  padding: 18px 16px 14px;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid rgba(139, 92, 246, 0.14);
  box-shadow: 0 12px 36px rgba(109, 40, 217, 0.16);
  text-align: center;
}

.quota-oa-title {
  display: block;
  font-size: 16px;
  font-weight: 650;
  color: #374151;
}

.quota-oa-sub {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  color: #7c7c8a;
}

.quota-oa-qr {
  width: 220px;
  height: 220px;
  margin: 14px auto 4px;
  display: block;
  border-radius: 12px;
  background: #faf8ff;
}

.quota-oa-box .quota-sheet-btn {
  margin-top: 12px;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  border-color: transparent;
  box-shadow: 0 4px 12px rgba(139, 92, 246, 0.22);
}

.quota-oa-box .quota-sheet-btn .quota-sheet-btn-t {
  color: #ffffff;
  font-weight: 600;
}
