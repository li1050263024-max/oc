<view class="quota-sheet-root">
  <view class="quota-sheet-mask" catchtap="onMaskTap"></view>
  <view class="quota-sheet-panel" catchtap="onPanelTap">
    <view class="quota-sheet-handle"></view>
    <text class="quota-sheet-title">本周免费额度已用尽</text>

    <view class="quota-sheet-btn quota-sheet-btn--primary" bindtap="onWatchAd" wx:if="{{!isVip}}">
      <text class="quota-sheet-btn-t">看广告并点击领取额度（+30 点）</text>
    </view>
    <text class="quota-sheet-ad-hint" wx:if="{{!isVip}}">须观看激励视频并点击进入详情；未点到可再看一条补点</text>
    <text class="quota-sheet-ad-hint" wx:if="{{isVip}}">会员免广告 · 可直接领取 +30 点</text>
    <view class="quota-sheet-btn quota-sheet-btn--primary" bindtap="onWatchAd" wx:if="{{isVip}}">
      <text class="quota-sheet-btn-t">领取额度（+30 点）</text>
    </view>

    <view
      class="quota-sheet-btn {{shareLeft > 0 ? '' : 'quota-sheet-btn--disabled'}}"
      bindtap="onShare"
    >
      <text wx:if="{{shareLeft > 0}}" class="quota-sheet-btn-t">分享至群聊续期（+10 轮，今日还剩{{shareLeft}}次）</text>
      <text wx:else class="quota-sheet-btn-t">今日分享次数已用完</text>
    </view>

    <view class="quota-sheet-btn quota-sheet-btn--ok" bindtap="onRedeem">
      <text class="quota-sheet-btn-t">去额度商店</text>
    </view>

    <view class="quota-sheet-btn quota-sheet-btn--ghost" bindtap="onCancel">
      <text class="quota-sheet-btn-t">取消</text>
    </view>
  </view>
</view>
