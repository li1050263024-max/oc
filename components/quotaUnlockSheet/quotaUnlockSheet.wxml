<view class="quota-sheet-root">
  <view class="quota-sheet-mask" catchtap="onMaskTap"></view>
  <view class="quota-sheet-panel" catchtap="onPanelTap">
    <view class="quota-sheet-handle"></view>
    <text class="quota-sheet-title">本周免费额度已用尽</text>
    <text class="quota-sheet-sub">可分享续期、兑换码，或关注公众号获取兑换码</text>

    <view
      class="quota-sheet-btn {{shareLeft > 0 ? '' : 'quota-sheet-btn--disabled'}}"
      bindtap="onShare"
    >
      <text wx:if="{{shareLeft > 0}}" class="quota-sheet-btn-t">分享至群聊续期（+10 轮，今日还剩{{shareLeft}}次）</text>
      <text wx:else class="quota-sheet-btn-t">今日分享次数已用完</text>
    </view>

    <view class="quota-sheet-btn quota-sheet-btn--ok" bindtap="onRedeem">
      <text class="quota-sheet-btn-t">输入兑换码</text>
    </view>

    <view class="quota-sheet-btn quota-sheet-btn--primary" bindtap="onFollowOa">
      <text class="quota-sheet-btn-t">关注公众号获取兑换码</text>
    </view>

    <view class="quota-sheet-btn quota-sheet-btn--ghost" bindtap="onCancel">
      <text class="quota-sheet-btn-t">取消</text>
    </view>
  </view>

  <view class="quota-oa-mask" wx:if="{{oaVisible}}" catchtap="onCloseOa">
    <view class="quota-oa-box" catchtap="onPanelTap">
      <text class="quota-oa-title">关注公众号</text>
      <text class="quota-oa-sub">可查看更新说明，并获取兑换码</text>
      <image
        class="quota-oa-qr"
        src="/images/mp-oa-qrcode.png"
        mode="aspectFit"
        show-menu-by-longpress
      />
      <view class="quota-sheet-btn" bindtap="onCloseOa">
        <text class="quota-sheet-btn-t">关闭</text>
      </view>
    </view>
  </view>
</view>
