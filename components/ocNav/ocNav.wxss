.oc-nav-root {
  position: fixed;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  z-index: 999;
  pointer-events: none;
}

.nav-fab,
.nav-popup {
  pointer-events: auto;
}

.nav-fab {
  position: fixed;
  z-index: 1000;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--glass-bg, rgba(255, 255, 255, 0.85));
  border: 1rpx solid var(--glass-border, rgba(255, 255, 255, 0.55));
  box-shadow: 0 12rpx 32rpx rgba(139, 92, 246, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(24rpx);
}

.nav-fab-open {
  background: rgba(167, 139, 250, 0.35);
}

.nav-fab-icon {
  font-size: 36rpx;
  color: #6d28d9;
  font-weight: 600;
  line-height: 1;
}

.nav-popup {
  position: fixed;
  z-index: 1001;
  width: 280rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(200, 190, 220, 0.5);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.nav-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.1);
  background: rgba(167, 139, 250, 0.08);
}

.nav-drag-hint {
  font-size: 22rpx;
  color: #7c7c8a;
}

.nav-popup-close {
  font-size: 40rpx;
  line-height: 1;
  color: #7c7c8a;
  padding: 0 8rpx;
}

.nav-popup-item {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #374151;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.06);
}

.nav-popup-item-active {
  color: #6d28d9;
  font-weight: 600;
  background: rgba(167, 139, 250, 0.12);
}

.nav-popup-item-disabled {
  opacity: 0.45;
}
