.oc-nav-root {
  position: fixed;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  z-index: 1100;
  pointer-events: none;
}

.nav-tutorial-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.52);
  pointer-events: auto;
}

.nav-fab,
.nav-popup {
  pointer-events: auto;
}

.nav-fab {
  position: fixed;
  z-index: 1102;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid var(--theme-nav-ring);
  box-shadow: 0 12rpx 32rpx var(--theme-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-fab-icon {
  font-size: 36rpx;
  color: var(--diffuse-highlight);
  font-weight: 600;
  line-height: 1;
}

.nav-popup {
  position: fixed;
  z-index: 1102;
  width: 280rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid var(--theme-nav-ring-soft);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
}

.nav-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 8rpx 16rpx;
  border-bottom: 1rpx solid var(--theme-border);
  background: var(--theme-fill-soft);
}

.nav-drag-handle {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
}

.nav-drag-hint {
  font-size: 22rpx;
  color: #7c7c8a;
}

.nav-popup-close {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--diffuse-highlight);
  font-weight: 600;
}

.nav-popup-list {
  max-height: 62vh;
}

.nav-popup-item {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #374151;
  border-bottom: 1rpx solid var(--theme-border-faint);
}

.nav-popup-item-active {
  color: var(--diffuse-highlight);
  font-weight: 600;
  background: var(--theme-fill-soft2);
}

.nav-popup-item-disabled {
  opacity: 0.45;
}

.nav-popup-item-with-badge {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-badge {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  flex-shrink: 0;
  margin-left: 12rpx;
  box-shadow: 0 0 0 2rpx #fff;
}

.nav-oa-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  padding: 48rpx;
}

.nav-oa-card {
  position: relative;
  width: 560rpx;
  max-width: 100%;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-oa-close {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #9ca3af;
  font-weight: 600;
}

.nav-oa-qr {
  width: 420rpx;
  display: block;
}

.nav-oa-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b7280;
  text-align: center;
}
