<view class="oc-nav-root">
  <view
    wx:if="{{tutorialMask && popupOpen}}"
    class="nav-tutorial-mask"
    catchtap="onDismissTutorial"
  ></view>

  <view
    wx:if="{{!popupOpen}}"
    class="nav-fab"
    style="left: {{fabLeft}}px; top: {{fabTop}}px;"
    catchtouchstart="onFabDragStart"
    catchtouchmove="onFabDragMove"
    catchtouchend="onFabDragEnd"
    catchtouchcancel="onFabDragEnd"
  >
    <text class="nav-fab-icon">☰</text>
  </view>

  <view
    wx:if="{{popupOpen}}"
    class="nav-popup"
    style="left: {{panelLeft}}px; top: {{panelTop}}px;"
  >
    <view class="nav-popup-head">
      <view
        class="nav-drag-handle"
        catchtouchstart="onPanelDragStart"
        catchtouchmove="onPanelDragMove"
        catchtouchend="onPanelDragEnd"
        catchtouchcancel="onPanelDragEnd"
      >
        <text class="nav-drag-hint">拖动导航</text>
      </view>
      <view class="nav-popup-close" catchtap="onClosePopup">×</view>
    </view>
    <scroll-view class="nav-popup-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        class="nav-popup-item {{current === 'index' ? 'nav-popup-item-active' : ''}}"
        data-key="index"
        catchtap="onNavTap"
      >首页</view>
      <view
        class="nav-popup-item {{current === 'pools' ? 'nav-popup-item-active' : ''}}"
        data-key="pools"
        catchtap="onNavTap"
      >选项库</view>
      <view
        class="nav-popup-item {{current === 'notebook' ? 'nav-popup-item-active' : ''}}"
        data-key="notebook"
        catchtap="onNavTap"
      >设定本</view>
      <view
        class="nav-popup-item nav-popup-item-with-badge {{current === 'chat' ? 'nav-popup-item-active' : ''}} {{hasBioOc ? '' : 'nav-popup-item-disabled'}}"
        data-key="chat"
        catchtap="onNavTap"
      >
        <text>OC对话</text>
        <view wx:if="{{badgeChat}}" class="nav-badge"></view>
      </view>
      <view
        class="nav-popup-item nav-popup-item-with-badge {{current === 'groupChat' ? 'nav-popup-item-active' : ''}} {{hasBioOc ? '' : 'nav-popup-item-disabled'}}"
        data-key="groupChat"
        catchtap="onNavTap"
      >
        <text>OC群聊</text>
        <view wx:if="{{badgeGroupChat}}" class="nav-badge"></view>
      </view>
      <view
        class="nav-popup-item {{current === 'bio' ? 'nav-popup-item-active' : ''}} {{layer3Ready ? '' : 'nav-popup-item-disabled'}}"
        data-key="bio"
        catchtap="onNavTap"
      >OC小传</view>
      <view
        class="nav-popup-item {{current === 'story' ? 'nav-popup-item-active' : ''}} {{hasLocalOc ? '' : 'nav-popup-item-disabled'}}"
        data-key="story"
        catchtap="onNavTap"
      >OC故事</view>
      <view
        class="nav-popup-item {{current === 'ocapp' || current === 'moments' || current === 'douyin' ? 'nav-popup-item-active' : ''}} {{hasBioOc ? '' : 'nav-popup-item-disabled'}}"
        data-key="ocapp"
        catchtap="onNavTap"
      >OC APP</view>
      <view
        class="nav-popup-item {{current === 'feedback' ? 'nav-popup-item-active' : ''}}"
        data-key="feedback"
        catchtap="onNavTap"
      >意见与反馈</view>
      <view
        class="nav-popup-item"
        catchtap="onOpenRedeem"
      >额度商店</view>
      <view
        class="nav-popup-item"
        catchtap="onOpenStorageClean"
      >清除本地内容</view>
    </scroll-view>
  </view>

  <view
    wx:if="{{oaQrVisible}}"
    class="nav-oa-mask"
    catchtap="onCloseOaQr"
    catchtouchmove="preventMove"
  >
    <view class="nav-oa-card" catchtap="preventMove">
      <view class="nav-oa-close" catchtap="onCloseOaQr">×</view>
      <image
        class="nav-oa-qr"
        src="/images/mp-oa-qrcode.png"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
      />
      <text class="nav-oa-hint">可查看小程序版本更新说明及官方通知</text>
    </view>
  </view>
</view>
