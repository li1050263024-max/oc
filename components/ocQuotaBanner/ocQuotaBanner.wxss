.qb {
  position: relative;
  z-index: 40;
  margin: 0 20rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(42, 33, 64, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(42, 33, 64, 0.1);
  overflow: hidden;
  box-sizing: border-box;
}

.qb--dark {
  background: rgba(22, 24, 35, 0.88);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.qb-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
}

.qb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.qb-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2a2140;
  flex-shrink: 0;
}

.qb--dark .qb-title {
  color: #fff;
}

.qb-sum {
  font-size: 22rpx;
  color: rgba(42, 33, 64, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qb--dark .qb-sum {
  color: rgba(255, 255, 255, 0.78);
}

.qb-actions-inline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.qb-collapse {
  font-size: 22rpx;
  color: rgba(42, 33, 64, 0.55);
  padding: 6rpx 10rpx;
}

.qb--dark .qb-collapse {
  color: rgba(255, 255, 255, 0.55);
}

.qb-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(42, 33, 64, 0.45);
  background: rgba(42, 33, 64, 0.06);
}

.qb--dark .qb-close {
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.08);
}

.qb-panel {
  padding: 0 18rpx 18rpx;
  border-top: 1rpx solid rgba(42, 33, 64, 0.08);
}

.qb--dark .qb-panel {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.qb-detail {
  display: block;
  padding: 12rpx 0 14rpx;
  font-size: 22rpx;
  color: rgba(42, 33, 64, 0.55);
  line-height: 1.4;
}

.qb--dark .qb-detail {
  color: rgba(255, 255, 255, 0.55);
}

.qb-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.qb-btn {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(42, 33, 64, 0.08);
  border: 1rpx solid rgba(42, 33, 64, 0.1);
}

.qb-btn text {
  font-size: 22rpx;
  color: #2a2140;
  font-weight: 600;
}

.qb-btn--primary {
  background: rgba(254, 44, 85, 0.12);
  border-color: rgba(254, 44, 85, 0.28);
}

.qb-btn--primary text {
  color: #fe2c55;
}

.qb--dark .qb-btn {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}

.qb--dark .qb-btn text {
  color: rgba(255, 255, 255, 0.9);
}

.qb-oa {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.qb-oa-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.qb-oa-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2a2140;
}

.qb-oa-sub {
  font-size: 24rpx;
  color: rgba(42, 33, 64, 0.55);
  text-align: center;
  line-height: 1.45;
}

.qb-oa-qr {
  width: 360rpx;
  height: 360rpx;
  margin: 12rpx 0;
}
