<view class="page oc-page safe-bottom {{uiThemeClass}}">
  <view class="bg-solid"></view>
  <oc-page-nav />
  <oc-back-btn />
  <view class="oc-page-shell story-sub-shell">
    <scroll-view class="story-sub-panel" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="story-sub-inner">
        <text class="story-sub-lead" wx:if="{{ocName}}">为「{{ocName}}」生成故事</text>

        <view class="section-card" wx:if="{{!story}}">
          <view class="field-label">故事方向</view>
          <textarea
            class="story-input story-input--box"
            placeholder="例如：雨夜码头重逢；写一段与宿敌的短对话；基调偏治愈……"
            maxlength="1200"
            value="{{userInput}}"
            bindinput="onUserInput"
            show-confirm-bar="{{false}}"
            auto-height
            cursor-spacing="24"
          />
        </view>
        <view class="story-btn-outside" wx:if="{{!story}}">
          <view
            class="pixel-btn pixel-btn-primary gen-btn {{loading ? 'gen-btn--disabled' : ''}}"
            catchtap="onGenerate"
          >
            <text class="gen-btn-text">{{loading ? '生成中…' : '生成 OC 故事'}}</text>
          </view>
        </view>

        <view class="section-card" wx:if="{{story}}">
          <view class="field-label">故事题目</view>
          <input
            class="story-title-input"
            placeholder="请填写故事题目（保存必填）"
            maxlength="80"
            value="{{storyTitle}}"
            bindinput="onStoryTitleInput"
          />
          <view class="field-label field-label--sub">正文（可修改）</view>
          <textarea
            class="story-result story-result-edit"
            value="{{story}}"
            bindinput="onStoryInput"
            maxlength="-1"
            auto-height
            show-confirm-bar="{{false}}"
            cursor-spacing="24"
          />
          <view class="story-actions">
            <view class="pixel-btn pixel-btn-primary btn-action story-act-btn" catchtap="onSaveStory">
              <text class="btn-action-text">保存到故事集</text>
            </view>
            <view class="pixel-btn btn-action btn-wire-secondary story-act-btn" catchtap="onCopyStory">
              <text class="btn-action-text">复制</text>
            </view>
            <view
              class="pixel-btn btn-action btn-wire-secondary story-act-btn {{loading ? 'gen-btn--disabled' : ''}}"
              catchtap="onGenerate"
            >
              <text class="btn-action-text">{{loading ? '生成中…' : '重新生成'}}</text>
            </view>
            <view class="pixel-btn btn-action btn-wire-secondary story-act-btn" catchtap="onDiscardStory">
              <text class="btn-action-text">放弃</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
