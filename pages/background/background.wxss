.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 120rpx;
  box-sizing: border-box;
}
.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title-wrap {
  margin-bottom: 32rpx;
  text-align: center;
}
.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}

/* 金色卡牌：未翻开 / 翻开，居中对齐 */
.flip-wrap {
  width: 100%;
  max-width: 640rpx;
  perspective: 1200rpx;
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.flip-inner {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  transform-style: preserve-3d;
  transition: transform 0.5s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.flip-inner.flipped {
  transform: rotateY(180deg);
}
.flip-back,
.flip-front {
  position: relative;
  width: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.flip-back {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  min-height: 400rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.flip-front {
  min-height: 400rpx;
  transform: rotateY(180deg);
}
.draw-card {
  width: 480rpx;
  min-height: 340rpx;
  margin: 0 auto;
  padding: 64rpx 72rpx;
  background: var(--diffuse-card-back);
  border: none;
  border-radius: 24rpx;
  box-shadow: var(--diffuse-card-back-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
}
.draw-card-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.draw-card-label {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 6rpx;
  margin-bottom: 24rpx;
}
.draw-card-text {
  font-size: 52rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.card-front {
  background: transparent;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-wrap {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}
.section-card {
  width: 100%;
  max-width: 640rpx;
  margin-bottom: 24rpx;
  align-self: center;
  padding: 28rpx 36rpx 36rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}
.section-card .card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
  text-align: center;
}
.section-card .card-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.08);
}
.section-card .card-row:last-of-type { border-bottom: none; }
.section-card .label {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}
.section-card .value-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 12rpx;
  margin: 0 8rpx;
  font-size: 28rpx;
  color: var(--diffuse-text);
  font-weight: 500;
  background: transparent;
  border: none;
  border-radius: 0;
}
.section-card .row-locked {
  background: rgba(167, 139, 250, 0.06);
}
.section-card .lock-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--diffuse-highlight);
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
.section-card .lock-btn.locked {
  color: var(--diffuse-subtle);
  background: rgba(167, 139, 250, 0.1);
}
.actions {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.actions-small {
  margin-top: 20rpx;
}
.btn-action {
  min-width: 160rpx;
  height: 68rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
}
.btn-action-text {
  font-size: 28rpx;
  color: inherit;
}
