.page-settings {
  min-height: 100vh;
  box-sizing: border-box;
}

.page-settings .bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.page-settings-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: calc(env(safe-area-inset-top) + 88rpx) 28rpx 24rpx;
  box-sizing: border-box;
}

.page-settings-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--diffuse-text);
}

.page-settings-body {
  position: relative;
  z-index: 1;
  padding: 0 28rpx 40rpx;
}

.page-settings-label {
  display: block;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  margin-bottom: 20rpx;
}

.theme-picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.theme-card {
  flex: 1 1 calc(33.33% - 12rpx);
  min-width: 200rpx;
  padding: 20rpx 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid var(--theme-border-soft);
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-sm);
  box-sizing: border-box;
}

.theme-mono .theme-card {
  border-color: rgba(63, 63, 70, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(24, 24, 27, 0.06);
}

.theme-card--active {
  border-color: var(--diffuse-highlight);
  box-shadow: 0 10rpx 28rpx var(--theme-shadow-md);
}

.theme-mono .theme-card--active {
  box-shadow: 0 10rpx 28rpx rgba(24, 24, 27, 0.12);
}

.theme-card-preview {
  width: 100%;
  height: 120rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.theme-card-preview--purple {
  background: radial-gradient(
      ellipse 90% 80% at 50% 30%,
      rgba(220, 210, 245, 0.95) 0%,
      rgba(242, 236, 252, 0.75) 40%,
      rgba(200, 214, 238, 0.35) 100%
    ),
    linear-gradient(145deg, #c8bee4, #b0c4e0);
}

.theme-card-preview--mono {
  background: radial-gradient(
      ellipse 90% 80% at 50% 30%,
      rgba(250, 250, 250, 0.98) 0%,
      rgba(228, 228, 231, 0.82) 42%,
      rgba(212, 212, 216, 0.45) 100%
    ),
    linear-gradient(145deg, #f4f4f5, #d4d4d8);
}

.theme-card-preview--pink {
  background: radial-gradient(
      ellipse 76% 66% at 88% 86%,
      rgba(181, 171, 204, 0.72) 0%,
      rgba(181, 171, 204, 0.28) 38%,
      transparent 68%
    ),
    radial-gradient(
      ellipse 70% 58% at 12% 16%,
      rgba(184, 215, 238, 0.68) 0%,
      rgba(184, 215, 238, 0.22) 40%,
      transparent 66%
    ),
    radial-gradient(
      ellipse 88% 72% at 50% 48%,
      rgba(247, 201, 211, 0.65) 0%,
      rgba(232, 166, 179, 0.32) 45%,
      transparent 78%
    ),
    linear-gradient(145deg, #ffffff, #f7c9d3 48%, #f8fbfe);
}

.theme-pink .theme-card {
  border-color: rgba(181, 171, 204, 0.14);
  box-shadow: 0 8rpx 24rpx rgba(181, 171, 204, 0.08);
}

.theme-pink .theme-card--active {
  box-shadow: 0 10rpx 28rpx rgba(232, 166, 179, 0.14);
}

.theme-card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  margin-bottom: 6rpx;
}

.theme-card-desc {
  display: block;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.4;
}

.page-settings-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
}
