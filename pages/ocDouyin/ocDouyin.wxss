.dy-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: #0a0a0c;
  color: #f5f5f7;
  overflow: hidden;
}

.dy-top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: calc(12rpx + env(safe-area-inset-top)) 28rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), transparent);
  pointer-events: none;
}

.dy-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  pointer-events: auto;
}

.dy-top-actions {
  display: flex;
  gap: 16rpx;
  pointer-events: auto;
}

.dy-top-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.dy-loading,
.dy-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 0 48rpx;
  z-index: 5;
}

.dy-loading-text,
.dy-empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  line-height: 1.5;
}

.dy-empty-btn {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 26rpx;
}

.dy-swiper {
  width: 100%;
}

.dy-item,
.dy-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.dy-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #141418;
}

.dy-image--broken {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #1a1a20;
}

.dy-broken-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.75);
}

.dy-broken-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 0 48rpx;
  text-align: center;
  line-height: 1.4;
}

.dy-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48%;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.72));
  pointer-events: none;
}

.dy-side {
  position: absolute;
  right: 20rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  z-index: 6;
}

.dy-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.dy-avatar {
  width: 100%;
  height: 100%;
}

.dy-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #6d28d9;
  font-size: 36rpx;
}

.dy-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 72rpx;
}

.dy-action-icon {
  font-size: 48rpx;
  line-height: 1;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.45);
}

.dy-action-icon--comment {
  font-size: 40rpx;
}

.dy-action-icon--share {
  font-size: 44rpx;
  font-weight: 700;
}

.dy-action--like-on .dy-action-icon {
  color: #ff4d6d;
}

.dy-action--fav-on .dy-action-icon {
  color: #ffd666;
}

.dy-action-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}

.dy-bottom {
  position: absolute;
  left: 28rpx;
  right: 140rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 6;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dy-name {
  font-size: 30rpx;
  font-weight: 600;
}

.dy-caption {
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.92);
}

.dy-tags {
  font-size: 24rpx;
  color: rgba(180, 220, 255, 0.9);
  line-height: 1.4;
}

.dy-album {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 评论半屏 */
.dy-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.45);
}

.dy-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  height: 58%;
  background: #16161a;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.dy-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.dy-sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f5f5f7;
}

.dy-sheet-close {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  padding: 8rpx 12rpx;
}

.dy-sheet-list {
  flex: 1;
  padding: 8rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.dy-comment-empty {
  padding: 48rpx 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 26rpx;
}

.dy-comment-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dy-comment-author {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

.dy-comment-text {
  font-size: 28rpx;
  color: #f0f0f2;
  line-height: 1.45;
}

.dy-sheet-compose {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 20rpx 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.dy-sheet-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 26rpx;
}

.dy-sheet-send {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fe2c55;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
