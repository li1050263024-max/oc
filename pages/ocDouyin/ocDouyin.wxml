<view class="dy-page">
  <view class="dy-top">
    <text class="dy-title">OC 抖音</text>
    <view class="dy-top-actions">
      <view class="dy-top-btn" catchtap="onGoMoments">朋友圈</view>
      <view class="dy-top-btn" catchtap="onRefreshTap">刷新</view>
    </view>
  </view>

  <view class="dy-loading" wx:if="{{loading || (generating && !feed.length)}}">
    <text class="dy-loading-text">{{generating ? '正在生成出镜文案…' : '加载中…'}}</text>
  </view>

  <view class="dy-empty" wx:elif="{{!feed.length}}">
    <text class="dy-empty-text">{{emptyHint}}</text>
    <view class="dy-empty-btn" catchtap="onRefreshTap">再试一次</view>
  </view>

  <swiper
    wx:else
    class="dy-swiper"
    vertical
    circular="{{false}}"
    current="{{current}}"
    bindchange="onSwiperChange"
    style="height: {{windowHeight}}px;"
  >
    <swiper-item wx:for="{{feed}}" wx:key="id" class="dy-item">
      <view class="dy-card">
        <image
          class="dy-image"
          src="{{item.imagePath}}"
          mode="aspectFill"
          lazy-load
          data-src="{{item.imagePath}}"
          catchtap="onPreviewImage"
        />
        <view class="dy-mask"></view>

        <view class="dy-side">
          <view class="dy-avatar-wrap" catchtap="onTapOc" data-oc-id="{{item.ocId}}">
            <image
              wx:if="{{item.avatarDisplay}}"
              class="dy-avatar"
              src="{{item.avatarDisplay}}"
              mode="aspectFill"
            />
            <view wx:else class="dy-avatar dy-avatar--ph">
              <text>{{item.avatarLetter}}</text>
            </view>
          </view>

          <view
            class="dy-action {{item.liked ? 'dy-action--like-on' : ''}}"
            catchtap="onToggleLike"
            data-id="{{item.id}}"
          >
            <text class="dy-action-icon">{{item.liked ? '♥' : '♡'}}</text>
            <text class="dy-action-label">{{item.likeCountText}}</text>
          </view>

          <view
            class="dy-action"
            catchtap="onOpenComment"
            data-id="{{item.id}}"
          >
            <text class="dy-action-icon dy-action-icon--comment">💬</text>
            <text class="dy-action-label">{{item.commentCountText}}</text>
          </view>

          <view
            class="dy-action {{item.favorited ? 'dy-action--fav-on' : ''}}"
            catchtap="onToggleFavorite"
            data-id="{{item.id}}"
          >
            <text class="dy-action-icon">{{item.favorited ? '★' : '☆'}}</text>
            <text class="dy-action-label">{{item.favCountText}}</text>
          </view>

          <view
            class="dy-action"
            catchtap="onShareTap"
            data-id="{{item.id}}"
          >
            <text class="dy-action-icon dy-action-icon--share">↗</text>
            <text class="dy-action-label">分享</text>
          </view>
        </view>

        <view class="dy-bottom">
          <text class="dy-name" catchtap="onTapOc" data-oc-id="{{item.ocId}}">@{{item.ocName}}</text>
          <text class="dy-caption" user-select>{{item.content}}</text>
          <text class="dy-tags" wx:if="{{item.tagText}}">{{item.tagText}}</text>
          <text class="dy-album" wx:if="{{item.albumName}}">来自图册 · {{item.albumName}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 评论面板 -->
  <view class="dy-sheet-mask" wx:if="{{commentOpen}}" catchtap="onCloseComment"></view>
  <view class="dy-sheet {{commentOpen ? 'dy-sheet--open' : ''}}" wx:if="{{commentOpen}}">
    <view class="dy-sheet-head">
      <text class="dy-sheet-title">评论 {{commentList.length || ''}}</text>
      <view class="dy-sheet-close" catchtap="onCloseComment">关闭</view>
    </view>
    <scroll-view class="dy-sheet-list" scroll-y>
      <view class="dy-comment-empty" wx:if="{{!commentList.length}}">
        <text>还没有评论，来抢沙发吧</text>
      </view>
      <view class="dy-comment-item" wx:for="{{commentList}}" wx:key="id">
        <text class="dy-comment-author">{{item.author}}</text>
        <text class="dy-comment-text">{{item.content}}</text>
      </view>
    </scroll-view>
    <view class="dy-sheet-compose">
      <input
        class="dy-sheet-input"
        value="{{commentText}}"
        bindinput="onCommentInput"
        placeholder="说点什么…"
        maxlength="200"
        confirm-type="send"
        bindconfirm="onSubmitComment"
      />
      <view class="dy-sheet-send" catchtap="onSubmitComment">发送</view>
    </view>
  </view>

  <oc-tab-bar current="douyin" flat-top="{{true}}" />
</view>
