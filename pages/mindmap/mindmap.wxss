/* 人设逻辑图 - 渐变弥散风格 */
.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 120rpx;
  box-sizing: border-box;
}
.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.diagram-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  text-align: center;
  width: 100%;
}
.center-node {
  width: 100%;
  max-width: 560rpx;
  padding: 32rpx 40rpx;
  margin-bottom: 32rpx;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  box-shadow: var(--glass-shadow);
}

.branch-wrap {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.branch-card {
  width: 100%;
  padding: 24rpx 28rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--diffuse-highlight);
  box-shadow: var(--glass-shadow);
  box-sizing: border-box;
}
.branch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 12rpx;
}
.branch-detail {
  font-size: 26rpx;
  color: var(--diffuse-text);
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.branch-detail:last-child {
  margin-bottom: 0;
}

.actions {
  width: 100%;
  max-width: 640rpx;
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.btn-action {
  min-width: 160rpx;
  height: 68rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
}
.btn-action-text {
  font-size: 28rpx;
  color: inherit;
}

.canvas-hidden {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
}
