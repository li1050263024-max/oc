.page {
  min-height: 100vh;
  position: relative;
}

.bg-solid {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: linear-gradient(165deg, #c8bee4 0%, #d4c8ec 42%, #c4d0e8 100%);
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.main {
  /* 加大与返回按钮的间距 */
  padding: 200rpx 28rpx 48rpx;
}

.album-hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.album-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.album-hero-titles {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.album-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2f2750;
  letter-spacing: 1rpx;
}

.album-hero-sub {
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.55);
}

.album-hero-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-top: 6rpx;
}

.side-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4a3d78;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(90, 70, 140, 0.18);
}

.side-btn--danger {
  color: #c45c5c;
  border-color: rgba(196, 92, 92, 0.35);
}

.album-desc-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(90, 70, 140, 0.16);
  font-size: 28rpx;
  line-height: 1.5;
  color: #2f2750;
  box-sizing: border-box;
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5b4b8a, #6d28d9);
  box-shadow: 0 10rpx 24rpx rgba(109, 40, 217, 0.22);
}

.upload-btn--disabled {
  opacity: 0.55;
}

.upload-btn-plus {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

.upload-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.grid-item {
  position: relative;
  width: 218rpx;
  height: 272rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(90, 70, 140, 0.14);
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

.grid-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(30, 20, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.empty {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-plus {
  font-size: 56rpx;
  color: #6d28d9;
  font-weight: 300;
}

.empty-text {
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.55);
}

.bottom-spacer {
  height: 80rpx;
}

.album-preview {
  position: fixed;
  inset: 0;
  z-index: 2000;
}

.album-preview-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(12, 8, 24, 0.88);
}

.album-preview-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-top: calc(88px + env(safe-area-inset-top));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.album-preview-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 8rpx 96rpx 16rpx 24rpx;
  box-sizing: border-box;
}

.album-preview-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.album-preview-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.album-preview-close {
  position: absolute;
  right: 20rpx;
  top: 96px;
  z-index: 3;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-preview-close-icon {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.album-preview-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.album-preview-item {
  height: 100%;
}

.album-preview-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 16rpx 24rpx;
}

.album-preview-img {
  width: 100%;
  height: 100%;
  display: block;
}
