.page {
  min-height: 100vh;
  position: relative;
}

.bg-solid {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: linear-gradient(165deg, #c8bee4 0%, #d4c8ec 42%, #c4d0e8 100%);
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.main {
  padding: 140rpx 28rpx 48rpx;
}

.album-hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.album-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2f2750;
  letter-spacing: 1rpx;
}

.album-hero-sub {
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.55);
}

.album-hero-preset {
  align-self: flex-start;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6d28d9;
  border: 1rpx solid rgba(109, 40, 217, 0.28);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4a3d78;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(90, 70, 140, 0.18);
}

.action-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, #5b4b8a, #6d28d9);
  border-color: transparent;
}

.action-btn--danger {
  color: #c45c5c;
  border-color: rgba(196, 92, 92, 0.35);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.grid-item {
  position: relative;
  width: 218rpx;
  height: 272rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(90, 70, 140, 0.14);
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

.grid-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(30, 20, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.empty {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-plus {
  font-size: 56rpx;
  color: #6d28d9;
  font-weight: 300;
}

.empty-text {
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.55);
}

.bottom-spacer {
  height: 80rpx;
}

.album-preview {
  position: fixed;
  inset: 0;
  z-index: 2000;
}

.album-preview-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(12, 8, 24, 0.88);
}

.album-preview-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  padding-bottom: env(safe-area-inset-bottom);
}

.album-preview-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 12rpx 88rpx 20rpx;
}

.album-preview-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.album-preview-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.album-preview-close {
  position: absolute;
  right: 24rpx;
  top: 4rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-preview-close-icon {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.album-preview-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.album-preview-item {
  height: 100%;
}

.album-preview-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 16rpx 24rpx;
}

.album-preview-img {
  width: 100%;
  height: 100%;
  display: block;
}
