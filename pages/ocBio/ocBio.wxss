.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.main {
  position: relative;
  z-index: 1;
  max-width: 640rpx;
  margin: 0 auto;
}

.lead {
  display: block;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.section-card {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx 32rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 16rpx;
}

.hints-area {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.gen-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
}

.gen-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: inherit;
}

.out-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
}

.bio-text {
  display: block;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 24rpx;
}

.copy-btn {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
}

.copy-btn .gen-btn-text {
  color: var(--diffuse-text);
}
