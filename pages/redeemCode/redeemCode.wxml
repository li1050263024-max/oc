<view class="page redeem-page safe-bottom {{uiThemeClass}}">
  <view class="bg-solid"></view>
  <view class="redeem-page-head">
    <oc-back-btn />
    <text class="redeem-page-title">额度商店</text>
  </view>

  <view class="redeem-page-body">
    <view class="redeem-card">
      <text class="redeem-balance">额度剩余 <text class="redeem-balance-num">{{extraRounds}}</text> 点</text>
      <text class="redeem-balance-sub">永久通用 · 对话 / 提取 / 扩容等</text>
    </view>

    <view class="redeem-card" wx:if="{{shopProducts.length}}">
      <text class="redeem-shop-title">充值额度</text>
      <text class="redeem-shop-sub">仅开放 10 元档 · 支付成功后自动到账</text>
      <view
        class="redeem-shop-item"
        wx:for="{{shopProducts}}"
        wx:key="productId"
        data-id="{{item.productId}}"
        data-title="{{item.title}}"
        bindtap="onBuyProduct"
      >
        <view class="redeem-shop-item-main">
          <text class="redeem-shop-item-title">{{item.title}}</text>
          <text class="redeem-shop-item-desc">{{item.desc}}</text>
        </view>
        <view class="redeem-shop-item-buy {{buyingId === item.productId ? 'redeem-shop-item-buy--busy' : ''}}">
          <text class="redeem-shop-item-price">¥{{item.priceYuan}}</text>
          <text class="redeem-shop-item-cta">{{buyingId === item.productId ? '…' : '充值'}}</text>
        </view>
      </view>
    </view>

    <view class="redeem-card" wx:else>
      <text class="redeem-shop-sub">充值通道加载中或未配置，请稍后重试</text>
    </view>
  </view>
</view>
