.redeem-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.redeem-page .bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.redeem-page-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: calc(env(safe-area-inset-top) + 88rpx) 28rpx 24rpx;
  box-sizing: border-box;
}

.redeem-page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--diffuse-text);
}

.redeem-page-body {
  position: relative;
  z-index: 1;
  padding: 8rpx 28rpx 48rpx;
}

.redeem-card {
  padding: 28rpx 24rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid var(--theme-border-soft);
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-sm);
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.redeem-card--vip {
  background: linear-gradient(
    135deg,
    rgba(255, 244, 230, 0.95),
    rgba(255, 255, 255, 0.88)
  );
  border-color: rgba(212, 160, 80, 0.4);
}

.redeem-vip-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #9a5b12;
  margin-bottom: 10rpx;
}

.redeem-vip-expire {
  display: block;
  font-size: 26rpx;
  color: #6b4a22;
  line-height: 1.5;
}

.redeem-balance {
  display: block;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.45;
}

.redeem-balance-num {
  font-weight: 700;
  color: var(--diffuse-highlight);
  font-size: 34rpx;
}

.redeem-shop-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--diffuse-text);
  margin-bottom: 6rpx;
}

.redeem-shop-sub {
  display: block;
  font-size: 22rpx;
  color: var(--diffuse-muted, #888);
  margin-bottom: 16rpx;
}

.redeem-shop-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--theme-border-soft);
}

.redeem-shop-item-main {
  flex: 1;
  min-width: 0;
}

.redeem-shop-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-text);
}

.redeem-shop-item-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--diffuse-muted, #888);
}

.redeem-shop-item-buy {
  flex-shrink: 0;
  min-width: 140rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--diffuse-highlight, #6c5ce7);
  text-align: center;
}

.redeem-shop-item-buy--busy {
  opacity: 0.6;
}

.redeem-shop-item-price {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.redeem-shop-item-cta {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.redeem-card--price {
  padding-top: 24rpx;
}

.redeem-price-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--diffuse-text);
  margin-bottom: 16rpx;
}

.redeem-price-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--theme-border-soft);
}

.redeem-price-left {
  flex: 1;
  min-width: 0;
}

.redeem-price-name {
  display: block;
  font-size: 26rpx;
  color: var(--diffuse-text);
  line-height: 1.4;
}

.redeem-price-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.35;
}

.redeem-price-cost {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  line-height: 1.4;
}

.redeem-balance-sub {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.4;
}

.redeem-refresh {
  margin-top: 8rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(124, 58, 237, 0.08);
  border: 1rpx solid rgba(124, 58, 237, 0.18);
}

.redeem-refresh-t {
  font-size: 24rpx;
  color: #6d28d9;
  font-weight: 600;
  line-height: 1.4;
}

.redeem-input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--theme-border-soft);
  font-size: 30rpx;
  color: var(--diffuse-text);
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.redeem-btn {
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--diffuse-highlight);
}

.redeem-btn--ad {
  margin-top: 16rpx;
  background: transparent;
  border: 2rpx solid rgba(139, 92, 246, 0.28);
}

.redeem-btn--ad .redeem-btn-text {
  color: var(--diffuse-highlight);
}

.redeem-btn--oa {
  margin-top: 16rpx;
  background: linear-gradient(
    135deg,
    rgba(233, 224, 255, 0.95) 0%,
    rgba(255, 255, 255, 0.98) 100%
  );
  border: 2rpx solid rgba(139, 92, 246, 0.28);
  box-shadow: 0 4rpx 12rpx rgba(109, 40, 217, 0.08);
}

.redeem-btn--oa .redeem-btn-text {
  color: #6d28d9;
  font-weight: 600;
}

/* 与导航栏「关注公众号」弹窗一致 */
.redeem-oa-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  padding: 48rpx;
  box-sizing: border-box;
}

.redeem-oa-card {
  position: relative;
  width: 560rpx;
  max-width: 100%;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.redeem-oa-close {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #9ca3af;
  font-weight: 600;
}

.redeem-oa-qr {
  width: 420rpx;
  display: block;
}

.redeem-oa-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b7280;
  text-align: center;
}

.redeem-btn--disabled {
  opacity: 0.55;
}

.redeem-ad-hint {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.45;
  text-align: center;
}

.redeem-ad-hint + .redeem-btn {
  margin-top: 14rpx;
}

.redeem-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.redeem-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
}
