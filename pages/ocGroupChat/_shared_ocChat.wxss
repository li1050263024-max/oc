.page {
  height: 100vh;
  box-sizing: border-box;
  background: transparent;
}

.page.has-tab-bar {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  overflow: visible;
  box-sizing: border-box;
}

.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.layout {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  gap: 12rpx;
}

/* 列表图标：与微信胶囊同高对齐，fixed 不占布局宽度 */
.chat-list-rail {
  position: fixed;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  pointer-events: none;
  box-sizing: border-box;
}

.chat-list-rail .chat-list-toggle,
.chat-list-rail .panel-list-btn {
  pointer-events: auto;
}

.chat-list-rail-inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 100%;
  pointer-events: auto;
}

.chat-list-rail .panel-list-btn {
  flex: none;
  min-width: 0;
  padding: 6rpx 16rpx;
}

/* 对话区卡片列 */
.chat-column {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 顶栏列表图标：无底色，仅三横线 */
.chat-list-toggle {
  flex-shrink: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  box-sizing: border-box;
}

.chat-list-icon {
  width: 40rpx;
  height: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chat-list-icon-line {
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--diffuse-highlight, #8b5cf6);
}

.chat-list-toggle--on .chat-list-icon-line {
  background: var(--diffuse-highlight);
}

.chat-oc-name-box--empty {
  padding-left: 0;
}

.chat-oc-name-text--empty {
  color: var(--diffuse-subtle, #7c7c8a);
  font-weight: 500;
}

/* 侧栏展开/收起：CSS 三角，避免 ▶◀ 在手机上渲染成 emoji */
.oc-chevron {
  flex-shrink: 0;
  width: 0;
  height: 0;
  border-style: solid;
}
.oc-chevron--right {
  border-width: 10rpx 0 10rpx 14rpx;
  border-color: transparent transparent transparent var(--diffuse-highlight);
}
.oc-chevron--down {
  margin-left: 6rpx;
  border-width: 10rpx 8rpx 0 8rpx;
  border-color: #ffffff transparent transparent transparent;
}
.oc-chip-btn--with-chevron {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.oc-panel {
  width: 300rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  overflow: hidden;
  transition: width 0.2s ease;
}

.oc-panel--names {
  width: 120rpx;
}

.oc-panel--names .oc-item {
  padding: 16rpx 8rpx;
}

.oc-panel--names .oc-item-name {
  font-size: 22rpx;
  text-align: center;
}

.panel-list-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--theme-border-strong);
  background: rgba(255, 255, 255, 0.35);
  box-sizing: border-box;
}

.panel-list-btn--on {
  background: var(--theme-fill-mid);
  border-color: rgba(124, 58, 237, 0.45);
}

.panel-list-btn-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
}

.oc-detail-card {
  position: relative;
  margin: 10rpx 10rpx 0;
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-border);
  background: rgba(255, 255, 255, 0.35);
}

.oc-detail-card:last-child {
  margin-bottom: 10rpx;
}

.oc-detail-card--active {
  border-color: rgba(124, 58, 237, 0.45);
  background: var(--theme-fill-soft3);
}

.oc-detail-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 8rpx;
  word-break: break-all;
}

.oc-detail-row {
  display: flex;
  font-size: 20rpx;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.oc-detail-lab {
  width: 56rpx;
  flex-shrink: 0;
  color: var(--diffuse-subtle);
}

.oc-detail-val {
  flex: 1;
  color: var(--diffuse-text);
  word-break: break-all;
}
.oc-scroll {
  flex: 1;
  min-height: 0;
}
.oc-item {
  position: relative;
  padding: 18rpx 12rpx;
  border-top: 1rpx solid var(--theme-border-faint);
}
.oc-list-badge {
  position: absolute;
  top: 14rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.85);
}
.oc-item-active {
  background: var(--theme-fill-soft);
}
.oc-item-name {
  font-size: 24rpx;
  color: var(--diffuse-text);
  line-height: 1.35;
  word-break: break-all;
}
.oc-empty {
  padding: 20rpx 12rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.45;
}
.chat-panel {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(24rpx);
  overflow: hidden;
  position: relative;
}

.page.has-tab-bar .layout {
  flex: 1;
  min-height: 0;
  height: auto !important;
  padding-top: 4rpx;
  padding-bottom: 8rpx;
}
.chat-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.chat-bg-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(255, 255, 255, 0.62);
  pointer-events: none;
}
.chat-panel .chat-head {
  position: relative;
  z-index: 15;
}
.chat-panel .scenario-bar,
.chat-panel .chat-scroll,
.chat-panel .composer {
  position: relative;
  z-index: 2;
}
.chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx 16rpx 20rpx;
  border-bottom: 1rpx solid var(--theme-border-soft);
}
.chat-with {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-text);
}
.chat-head-actions {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
  margin-right: 0;
}

.chat-quota-badge {
  flex-shrink: 0;
  max-width: 280rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--theme-border-soft);
  box-sizing: border-box;
}

.chat-quota-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--diffuse-subtle);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-head-actions .oc-chip-btn {
  padding: 8rpx 14rpx;
  min-height: 48rpx;
}

.chat-head-more-wrap {
  position: relative;
  flex-shrink: 0;
}

.chat-more-btn--head {
  min-height: 48rpx;
  width: 52rpx;
  background: var(--theme-fill-mid2);
  border-color: rgba(124, 58, 237, 0.28);
}

.chat-more-menu--head {
  top: calc(100% + 6rpx);
  right: 0;
  z-index: 200;
}

.scenario-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  min-height: 44rpx;
}

.scenario-bar {
  position: relative;
  padding: 10rpx 12rpx 12rpx 20rpx;
  border-bottom: 1rpx solid var(--theme-border-soft);
  background: rgba(237, 233, 254, 0.35);
}
.scenario-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.scenario-main--empty {
  justify-content: flex-start;
  gap: 12rpx;
}
.scenario-main--empty .scenario-hint {
  flex: 1;
  min-width: 0;
}
.scenario-main--empty .scenario-chip {
  flex-shrink: 0;
  margin-left: auto;
}
.scenario-main:not(.scenario-main--empty) .scenario-title {
  flex: 1;
  min-width: 0;
}
.scenario-actions-end {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
  margin-left: auto;
}
.chat-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--theme-border-mid);
  box-sizing: border-box;
}
.chat-more-icon {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--diffuse-highlight);
  letter-spacing: 2rpx;
}
.chat-more-menu {
  position: absolute;
  z-index: 30;
  min-width: 140rpx;
  padding: 8rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid var(--theme-border-mid);
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-lg);
  box-sizing: border-box;
}
.chat-more-item {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #374151;
  text-align: center;
}
.scenario-label {
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  flex-shrink: 0;
}
.scenario-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--diffuse-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scenario-hint {
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}

.chat-head--picker {
  flex-direction: column;
  align-items: stretch;
  position: relative;
  z-index: 20;
}
.chat-head-top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
}
.chat-oc-name-box,
.chat-group-name-box {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  padding: 10rpx 4rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}
.chat-oc-name-text,
.chat-group-name-text {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-picker {
  margin-top: 12rpx;
  width: 100%;
  max-height: 520rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-border-mid2);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-card-sm);
}
.session-picker-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
  border-bottom: 1rpx solid var(--theme-border-soft);
  background: rgba(237, 233, 254, 0.45);
  flex-shrink: 0;
}
.session-picker-top-new {
  flex: 1;
  min-width: 0;
}
.session-picker-top-spacer {
  flex: 1;
  min-width: 0;
}
.session-picker-bottom-new {
  padding: 14rpx 16rpx;
  border-top: 1rpx solid var(--theme-border);
  background: rgba(237, 233, 254, 0.45);
  flex-shrink: 0;
}
.session-picker-selected-count {
  flex: 1;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}
.session-picker-manage-btn {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 6rpx 16rpx;
}
.session-picker-scroll {
  flex: 1;
  min-height: 0;
  height: 360rpx;
  max-height: 360rpx;
  box-sizing: border-box;
}
.session-picker-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 12rpx 14rpx 16rpx;
  border-bottom: 1rpx solid var(--theme-border-faint);
}
.session-picker-item-main {
  flex: 1;
  min-width: 0;
}
.session-picker-del {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 6rpx 14rpx;
}
.session-picker-item--active {
  background: var(--theme-fill-mid2);
}
.session-picker-item--new {
  background: rgba(237, 233, 254, 0.6);
}
.session-picker-item--checked {
  background: var(--theme-fill-mid);
}
.session-picker-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-right: 4rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--theme-border-heavy);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.session-picker-check--on {
  background: var(--theme-chip-bg);
  border-color: var(--theme-chip-border);
}
.session-picker-check-icon {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
}
.session-picker-manage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx 12rpx;
  border-top: 1rpx solid var(--theme-border-soft);
  flex-shrink: 0;
}
.session-picker-manage-link {
  font-size: 26rpx;
  color: var(--diffuse-highlight);
  padding: 8rpx 4rpx;
}
.session-picker-batch-del {
  min-height: 48rpx;
  padding: 6rpx 20rpx;
}
.session-picker-title {
  display: block;
  font-size: 26rpx;
  color: var(--diffuse-text);
  font-weight: 500;
}
.session-picker-preview {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-picker-empty {
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}
.session-picker-hint {
  display: block;
  padding: 10rpx 16rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--diffuse-subtle);
  text-align: center;
  border-top: 1rpx solid var(--theme-border-soft);
}

.scenario-preview {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--theme-border-mid2);
}
.scenario-preview-label {
  display: block;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  margin-bottom: 8rpx;
}
.scenario-preview-p {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--diffuse-text);
  white-space: pre-wrap;
  word-break: break-word;
}
.scenario-preview-p:last-child {
  margin-bottom: 0;
}

.story-import-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1250;
}
.story-import-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(112rpx + 24rpx + env(safe-area-inset-bottom));
  max-height: 62vh;
  z-index: 1251;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx var(--theme-shadow-card-md);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.story-import-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
}
.story-import-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}
.story-import-scroll {
  flex: 1;
  min-height: 120rpx;
  max-height: 48vh;
  margin: 16rpx 0;
}
.story-import-actions {
  display: flex;
  gap: 16rpx;
}
.story-import-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
}

.panel-scroll-area {
  flex: 1;
  min-height: 0;
}

.panel-trash {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 8rpx 14rpx;
  border-top: 1rpx solid var(--theme-border-mid);
  background: rgba(255, 255, 255, 0.25);
  transition: background 0.15s ease;
}
.panel-trash--hot {
  background: rgba(254, 226, 226, 0.85);
  border-top-color: rgba(185, 28, 28, 0.35);
}
.panel-trash-hint {
  font-size: 18rpx;
  color: var(--diffuse-subtle);
}
.panel-trash--hot .panel-trash-hint {
  color: #b91c1c;
}

.panel-trash-icon-char {
  font-size: 44rpx;
  line-height: 1;
  opacity: 0.5;
}
.panel-trash--hot .panel-trash-icon-char {
  opacity: 1;
}

.oc-detail-card--dragging,
.oc-item--dragging {
  opacity: 0.35;
}

.drag-ghost {
  position: fixed;
  z-index: 450;
  pointer-events: none;
  transform: translate(-50%, -50%);
  max-width: 240rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: var(--theme-fill-solid-bg);
  color: #fff;
  font-size: 24rpx;
  box-shadow: 0 8rpx 24rpx var(--theme-shadow-card-bold);
}

.chat-with-wrap {
  flex: 1;
  min-width: 0;
}
.rename-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1200;
}
.rename-sheet {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 28%;
  z-index: 1201;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx var(--theme-shadow-card-md);
}
.avatar-edit-root.rename-mask {
  z-index: 9998;
}
.avatar-edit-root.rename-sheet {
  z-index: 9999;
}
.rename-sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  margin-bottom: 16rpx;
}
.rename-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.avatar-edit-sheet {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-edit-preview-wrap {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid var(--theme-border-heavy);
  margin: 8rpx auto 28rpx;
  background: rgba(255, 255, 255, 0.35);
}
.avatar-edit-preview {
  width: 100%;
  height: 100%;
}
.avatar-edit-preview--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #e9e0ff, var(--theme-accent-pale));
}
.avatar-edit-preview-hint {
  font-size: 24rpx;
  color: var(--diffuse-subtle);
  text-align: center;
  padding: 0 16rpx;
}
.avatar-edit-preview-wrap--wide {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
}
.avatar-edit-preview--wide {
  border-radius: 16rpx;
}
.avatar-edit-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.avatar-edit-action-btn {
  width: 100%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}
.avatar-edit-action-btn.disabled {
  opacity: 0.45;
}
.avatar-edit-action-btn--danger .btn-t {
  color: #c62828;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}
.chat-inner {
  padding: 16rpx 20rpx;
}
.msg-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  padding: 40rpx 0;
}
.msg-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.msg-user {
  justify-content: flex-end;
}
.msg-assistant {
