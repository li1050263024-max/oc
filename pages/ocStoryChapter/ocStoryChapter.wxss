@import "../../styles/storyContinue.wxss";

.page {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: transparent;
}

.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.chapter-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: transparent;
}

.chapter-header {
  flex-shrink: 0;
  padding: 0 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.chapter-oc {
  font-size: 24rpx;
  color: #7c7c8a;
  margin-left: 4rpx;
}

.chapter-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.chapter-inner {
  margin: 0 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
  padding: 24rpx;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.chapter-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.chapter-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #374151;
  white-space: pre-wrap;
}

.chapter-continue-wrap {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--theme-border-mid);
}

.chapter-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--theme-border-mid);
}

.chapter-actions--view {
  margin-top: 28rpx;
}

.chapter-action-btn {
  flex: 1;
  min-width: calc(50% - 8rpx);
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 12rpx;
}

.field-label--sub {
  margin-top: 16rpx;
}

.chapter-title-input {
  width: 100%;
  font-size: 28rpx;
  line-height: 1.55;
  color: #374151;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 10rpx;
  border: 1rpx solid var(--theme-border-mid2);
  margin-bottom: 4rpx;
}

.chapter-body-edit {
  width: 100%;
  font-size: 28rpx;
  line-height: 1.75;
  color: #374151;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 10rpx;
  border: 1rpx solid var(--theme-border-mid2);
}

.chapter-continue-btn {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}

.compare-sheet,
.history-sheet,
.history-preview-sheet {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 12%;
  bottom: 12%;
  z-index: 212;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 16rpx 48rpx var(--theme-shadow-card-md);
  border: 1rpx solid var(--theme-border-mid);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.compare-scroll,
.history-scroll,
.history-preview-scroll {
  flex: 1;
  min-height: 0;
  margin: 16rpx 0 20rpx;
}

.compare-rows {
  padding-bottom: 8rpx;
}

.compare-row {
  margin-bottom: 8rpx;
}

.compare-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
}

.compare-line--same {
  color: #374151;
}

.compare-line--old {
  color: #374151;
  background: #ffffff;
  border: 1rpx solid var(--theme-border);
  text-decoration: line-through;
}

.compare-line--new {
  color: #ffffff;
  background: var(--theme-chip-bg);
  margin-top: 4rpx;
}

.history-empty {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  padding: 48rpx 0;
}

.history-item {
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--theme-border-mid);
}

.history-item-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}

.history-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 8rpx;
}

.history-item-preview {
  font-size: 24rpx;
  line-height: 1.55;
  color: #4b5563;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.history-preview-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.history-preview-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: #374151;
  white-space: pre-wrap;
}
