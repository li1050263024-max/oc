.profile-page {
  min-height: 100vh;
  position: relative;
  width: 100%;
  overflow-x: hidden;
  background: var(--diffuse-bg);
  background-color: var(--p-bg);
  --p-bg: #c8bee4;
  --p-accent: #6d28d9;
  --p-deep: #7c3aed;
  --p-text: #5b4b8a;
  --p-muted: #8b7cb8;
  --p-a04: rgba(109, 40, 217, 0.04);
  --p-a05: rgba(109, 40, 217, 0.05);
  --p-a10: rgba(109, 40, 217, 0.1);
  --p-a12: rgba(109, 40, 217, 0.12);
  --p-a14: rgba(109, 40, 217, 0.14);
  --p-a15: rgba(109, 40, 217, 0.15);
  --p-a16: rgba(109, 40, 217, 0.16);
  --p-a18: rgba(109, 40, 217, 0.18);
  --p-a20: rgba(109, 40, 217, 0.2);
  --p-a22: rgba(109, 40, 217, 0.22);
  --p-a25: rgba(109, 40, 217, 0.25);
  --p-a28: rgba(109, 40, 217, 0.28);
  --p-a32: rgba(109, 40, 217, 0.32);
  --p-a34: rgba(109, 40, 217, 0.34);
  --p-a35: rgba(109, 40, 217, 0.35);
  --p-a38: rgba(109, 40, 217, 0.38);
  --p-a42: rgba(109, 40, 217, 0.42);
  --p-a45: rgba(109, 40, 217, 0.45);
  --p-a55: rgba(109, 40, 217, 0.55);
  --p-a85: rgba(109, 40, 217, 0.85);
  --p-m15: rgba(139, 124, 184, 0.15);
  --p-m20: rgba(139, 124, 184, 0.2);
  --p-m25: rgba(139, 124, 184, 0.25);
  --p-m28: rgba(139, 124, 184, 0.28);
  --p-m30: rgba(139, 124, 184, 0.3);
  --p-m35: rgba(139, 124, 184, 0.35);
  --p-m45: rgba(139, 124, 184, 0.45);
  --p-l28: rgba(167, 139, 250, 0.28);
  --p-l35: rgba(167, 139, 250, 0.35);
  --p-l38: rgba(167, 139, 250, 0.38);
  --p-l42: rgba(167, 139, 250, 0.42);
  --p-ll28: rgba(196, 181, 253, 0.28);
  --p-ll32: rgba(196, 181, 253, 0.32);
  --p-s08: rgba(91, 75, 138, 0.08);
  --p-s10: rgba(91, 75, 138, 0.1);
  --p-s12: rgba(91, 75, 138, 0.12);
  --p-s18: rgba(61, 41, 120, 0.18);
  --p-card-end: rgba(245, 240, 255, 0.92);
  --p-wash-soft: rgba(243, 239, 250, 0.8);
  --profile-card-bg: linear-gradient(145deg, rgba(255, 252, 248, 0.96), var(--p-card-end));
  --profile-card-border: 2rpx solid var(--p-a14);
  --profile-card-shadow: 0 8rpx 32rpx var(--p-s08);
}

.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  background: var(--diffuse-bg);
  background-color: var(--p-bg);
  z-index: 0;
  overflow: hidden;
}

.profile-bg-sparkles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.profile-sparkle {
  position: absolute;
  color: var(--p-a22);
  font-size: 28rpx;
  line-height: 1;
}

.profile-sparkle--1 {
  top: 12%;
  left: 8%;
  font-size: 32rpx;
}

.profile-sparkle--2 {
  top: 22%;
  right: 18%;
  font-size: 22rpx;
  opacity: 0.7;
}

.profile-sparkle--3 {
  bottom: 28%;
  left: 14%;
  font-size: 20rpx;
  opacity: 0.55;
}

.profile-sparkle--4 {
  top: 38%;
  left: 4%;
  font-size: 36rpx;
  color: var(--p-m35);
}

.profile-sparkle--5 {
  bottom: 18%;
  right: 22%;
  font-size: 40rpx;
  color: var(--p-m28);
}

.profile-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  background: transparent;
  position: relative;
  z-index: 1;
}

.profile-scroll-inner {
  box-sizing: border-box;
  min-height: 100vh;
  background: transparent;
}

.profile-collapse-float {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-left: 10px;
  box-sizing: border-box;
  pointer-events: none;
}

.profile-collapse-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 32px;
  padding: 0 8rpx;
  pointer-events: auto;
}

.profile-layout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
  width: 100%;
  box-sizing: border-box;
}

.profile-layout-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.profile-tab-rail-slot {
  flex: 0 0 88rpx;
  width: 88rpx;
  min-height: 1px;
  box-sizing: border-box;
}

.profile-tab-rail {
  width: 88rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: visible;
  box-sizing: border-box;
}

.profile-tab-rail--fixed {
  position: fixed;
  right: 0;
  z-index: 120;
  /* 8 个侧栏按钮 × 140rpx + 7 个间距 × 8rpx */
  height: 1176rpx;
  min-height: 1176rpx;
  max-height: 1176rpx;
}

.profile-collapse-text {
  font-size: 24rpx;
  color: var(--p-muted);
  letter-spacing: 1rpx;
  margin-right: 8rpx;
}

.profile-collapse-icon {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid var(--p-muted);
  transition: transform 0.2s ease;
}

.profile-collapse-icon--open {
  transform: rotate(180deg);
}

.profile-card,
.profile-parse-block {
  background: var(--profile-card-bg);
  border: var(--profile-card-border);
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: var(--profile-card-shadow);
  box-sizing: border-box;
}

.profile-panel {
  background: var(--profile-card-bg);
  border: var(--profile-card-border);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: var(--profile-card-shadow);
  box-sizing: border-box;
}

.profile-card--ornate {
  position: relative;
  border: 1rpx solid var(--p-a22);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.72),
    0 10rpx 36rpx var(--p-s10);
}

.profile-card--ornate::before,
.profile-card--ornate::after {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-color: var(--p-a34);
  border-style: solid;
  pointer-events: none;
  z-index: 2;
}

.profile-card--ornate::before {
  top: 12rpx;
  left: 12rpx;
  border-width: 2rpx 0 0 2rpx;
}

.profile-card--ornate::after {
  top: 12rpx;
  right: 12rpx;
  border-width: 2rpx 2rpx 0 0;
}

.profile-corner {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-color: var(--p-a34);
  border-style: solid;
  pointer-events: none;
  z-index: 2;
}

.profile-corner--bl {
  left: 12rpx;
  bottom: 12rpx;
  border-width: 0 0 2rpx 2rpx;
}

.profile-corner--br {
  right: 12rpx;
  bottom: 12rpx;
  border-width: 0 2rpx 2rpx 0;
}

.profile-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
}

.profile-panel {
  min-height: 360rpx;
  position: relative;
  overflow: visible;
}

.profile-card-top {
  display: flex;
  align-items: flex-start;
}

.profile-card-left {
  width: 42%;
  flex-shrink: 0;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.profile-card-right {
  flex: 1;
  min-width: 0;
}

.profile-script-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx 4rpx 4rpx;
}

.profile-script-wrap--sm {
  margin-bottom: 8rpx;
  padding: 2rpx 10rpx 2rpx 2rpx;
}

.profile-script-wash {
  position: absolute;
  left: -4rpx;
  top: 50%;
  width: 120%;
  height: 140%;
  transform: translateY(-50%) skewX(-12deg);
  border-radius: 8rpx;
  background: linear-gradient(
    105deg,
    var(--p-l42) 0%,
    var(--p-ll28) 55%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 0;
}

.profile-script-wash--sm {
  width: 110%;
  height: 130%;
}

.profile-script-label {
  position: relative;
  z-index: 1;
  display: block;
  font-family: 'Segoe Script', 'Bradley Hand', cursive;
  font-size: 28rpx;
  color: var(--p-muted);
  margin-bottom: 0;
}

.profile-script-wrap--sm .profile-script-label {
  font-size: 24rpx;
}

.profile-portrait-wrap {
  position: relative;
  width: 100%;
  margin-bottom: 8rpx;
}

.profile-portrait-glow {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 88%;
  height: 76%;
  transform: translate(-50%, -50%);
  border-radius: 14rpx;
  background: radial-gradient(circle, var(--p-l35) 0%, transparent 72%);
  pointer-events: none;
  z-index: 0;
}

.profile-portrait-frame {
  position: relative;
  z-index: 1;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 14rpx;
  overflow: hidden;
  border: 3rpx solid var(--p-m45);
  background: #f3effa;
  box-shadow:
    0 0 0 2rpx rgba(255, 255, 255, 0.85),
    0 8rpx 28rpx var(--p-a16);
}

.profile-portrait-ornament {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  margin-top: -18rpx;
  padding-bottom: 2rpx;
}

.profile-portrait-vine {
  width: 44rpx;
  height: 22rpx;
  border-bottom: 2rpx solid var(--p-a32);
  margin-bottom: 10rpx;
}

.profile-portrait-vine--l {
  border-radius: 0 0 0 80%;
  transform: skewX(-8deg);
}

.profile-portrait-vine--r {
  border-radius: 0 0 80% 0;
  transform: skewX(8deg);
}

.profile-portrait-star {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid var(--p-a38);
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx var(--p-a18);
}

.profile-portrait-star text {
  font-size: 18rpx;
  color: var(--p-accent);
  line-height: 1;
}

.profile-section-title-wrap {
  position: relative;
  margin-bottom: 16rpx;
  padding: 6rpx 0;
}

.profile-section-title-wrap--with-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 48rpx;
}

.profile-section-title-wrap--with-action .profile-script-side {
  position: relative;
  flex: 1;
  min-width: 0;
}

.profile-basic-actions {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.profile-head-mini-btn--ghost {
  background: rgba(255, 255, 255, 0.55);
  color: var(--p-muted);
  border: 1rpx solid var(--p-m25);
}

.profile-field--edit {
  align-items: center;
}

.pf-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: #444;
  border-bottom: 1rpx solid var(--p-m35);
  background: rgba(255, 255, 255, 0.35);
  border-radius: 8rpx 8rpx 0 0;
}

.profile-section-wash {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 92%;
  height: 120%;
  transform: translate(-50%, -50%) skewX(-8deg);
  border-radius: 10rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--p-l38) 18%,
    var(--p-ll32) 50%,
    var(--p-l38) 82%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 0;
}

.profile-section-title {
  position: relative;
  z-index: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--p-accent);
  margin-bottom: 0;
}

.profile-notes-ornate {
  position: relative;
  margin-top: 16rpx;
  min-height: 100rpx;
  padding: 16rpx 14rpx 12rpx;
  border: 1rpx solid var(--p-m28);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.42);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.55);
  overflow: hidden;
}

.profile-notes-ornate::before,
.profile-notes-ornate::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border: 1rpx solid var(--p-a22);
  pointer-events: none;
}

.profile-notes-ornate::before {
  top: 8rpx;
  left: 8rpx;
  border-right: none;
  border-bottom: none;
}

.profile-notes-ornate::after {
  bottom: 8rpx;
  left: 8rpx;
  border-right: none;
  border-top: none;
}

.profile-notes-deco {
  position: absolute;
  right: 8rpx;
  bottom: 6rpx;
  width: 88rpx;
  height: 72rpx;
  pointer-events: none;
}

.profile-deco-moon {
  position: absolute;
  right: 6rpx;
  bottom: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  box-shadow: 10rpx -6rpx 0 0 var(--p-l28);
  opacity: 0.85;
}

.profile-deco-moon::after {
  content: '';
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--p-a12);
}

.profile-deco-star {
  position: absolute;
  color: var(--p-a28);
  font-size: 16rpx;
  line-height: 1;
}

.profile-deco-star--1 {
  top: 8rpx;
  right: 28rpx;
}

.profile-deco-star--2 {
  top: 22rpx;
  right: 8rpx;
  font-size: 12rpx;
  opacity: 0.75;
}

.profile-notes-text {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  line-height: 1.65;
  color: #555;
  word-break: break-all;
  padding-right: 72rpx;
}

.profile-notes-placeholder {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: #bbb;
  padding-right: 72rpx;
}

.profile-portrait-img {
  width: 100%;
  height: 100%;
}

.profile-entry-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--p-m25);
}

.profile-entry-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--p-accent);
  background: var(--p-a10);
  border: 1rpx solid var(--p-a20);
}

.profile-parse-block {
  margin-top: 16rpx;
}

.profile-parse-inner {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--p-m35);
  box-sizing: border-box;
}

.profile-parse-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--p-text);
  margin-bottom: 8rpx;
}

.profile-parse-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.profile-parse-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #444;
  border-radius: 12rpx;
  border: 1rpx dashed var(--p-m35);
  background: rgba(255, 255, 255, 0.45);
}

.profile-parse-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--p-deep), var(--p-accent));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.profile-parse-btn--disabled {
  opacity: 0.6;
}

.profile-field {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.pf-label {
  flex-shrink: 0;
  width: 5.5em;
  color: var(--p-muted);
}

.pf-label::after {
  content: '：';
}

.pf-val {
  flex: 1;
  color: #444;
  border-bottom: 1rpx dotted var(--p-m35);
  padding-bottom: 4rpx;
  word-break: break-all;
}

.profile-tab-item {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  padding: 12rpx 8rpx 14rpx;
  border-radius: 14rpx 6rpx 14rpx 6rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid var(--p-a16);
  text-align: center;
  flex: 0 0 140rpx;
  height: 140rpx;
  min-height: 140rpx;
  max-height: 140rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 4rpx 16rpx var(--p-s08);
}

.profile-tab-item--ornate::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 1rpx solid var(--p-a12);
  border-radius: 10rpx 4rpx 10rpx 4rpx;
  pointer-events: none;
}

.profile-tab-glyph {
  font-size: 20rpx;
  color: var(--p-a55);
  line-height: 1;
  margin-bottom: 6rpx;
  writing-mode: horizontal-tb;
}

.profile-tab-item--active {
  background: var(--p-a14);
  border-color: var(--p-a38);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.65),
    0 6rpx 20rpx var(--p-a14);
}

.profile-tab-item--active .profile-tab-glyph {
  color: var(--p-accent);
}

.profile-tab-label {
  font-size: 22rpx;
  color: var(--p-text);
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.profile-tab-sub {
  font-size: 16rpx;
  color: #aaa;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.profile-tab-item--active .profile-tab-label {
  color: var(--p-accent);
  font-weight: 600;
}

.profile-tab-extra {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
}

.profile-tab-extra-btn {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: var(--p-a10);
  border: 1rpx solid var(--p-a20);
  font-size: 22rpx;
  color: var(--p-accent);
  text-align: center;
  letter-spacing: 2rpx;
}

.profile-tab-extra-btn--active {
  background: var(--p-a22);
  border-color: var(--p-a45);
  font-weight: 600;
}

.profile-panel-body--bio-story {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-fold-block {
  border: 1rpx solid var(--p-a10);
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.35);
}

.profile-fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.28);
}

.profile-fold-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.profile-fold-hint {
  font-size: 22rpx;
  color: #888;
}

.profile-fold-body {
  padding: 16rpx 24rpx 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.profile-story-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-story-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-story-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
}

.profile-story-more {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--p-accent);
}

.profile-text-block--muted {
  color: #999;
}

.profile-panel-head {
  text-align: left;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--p-m20);
  box-sizing: border-box;
}

.profile-panel-head--with-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 10rpx;
  width: 100%;
}

.profile-panel-head-text {
  flex: 1;
  min-width: 0;
  max-width: 100%;
}

.profile-panel-head-actions {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-start;
  align-items: center;
  margin-left: 0;
  padding-top: 0;
