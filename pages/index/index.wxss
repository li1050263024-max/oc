.page-dimmed .oc-page-shell {
  opacity: 0.38;
  pointer-events: none;
}

.page.oc-page--gacha {
  position: relative;
}

.page.index-panel-open .oc-page-shell {
  position: relative;
  z-index: 30;
}

.page.index-panel-open .index-settings-wrap {
  z-index: 15;
}

.page.index-panel-open .index-home-title-float {
  visibility: hidden;
}

.page.index-panel-open .index-gacha-toolbar {
  position: relative;
  z-index: 10;
}

.page.index-panel-open .index-scope-panel {
  position: relative;
  z-index: 11;
  background-color: #ffffff;
  background: #ffffff;
}

.page.index-panel-open .oc-gacha-stage {
  position: relative;
  z-index: 1;
}
.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.canvas-hidden {
  position: fixed;
  left: -9999px;
  top: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.index-settings-wrap {
  position: absolute;
  z-index: 20;
}

.index-settings-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--theme-settings-bg, rgba(167, 139, 250, 0.92));
  border: 1rpx solid var(--theme-settings-border, rgba(139, 92, 246, 0.35));
  box-shadow: 0 4rpx 12rpx var(--theme-settings-shadow, rgba(109, 40, 217, 0.2));
}

.index-settings-hamburger {
  width: 28rpx;
  height: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.index-settings-bar {
  width: 100%;
  height: 3rpx;
  border-radius: 2rpx;
  background: #ffffff;
}

.index-settings-menu {
  position: absolute;
  top: 72rpx;
  left: 0;
  right: auto;
  min-width: 220rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid var(--theme-border-mid);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  z-index: 30;
}

.index-settings-item {
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #374151;
  border-bottom: 1rpx solid var(--theme-border-faint);
}

.index-settings-item:last-child {
  border-bottom: none;
}

.index-settings-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  /* 留出底部 Tab，避免挡住点击 */
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.index-oa-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.index-oa-card {
  position: relative;
  width: 560rpx;
  max-width: 100%;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.index-oa-close {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #9ca3af;
  font-weight: 600;
}

.index-oa-qr {
  width: 420rpx;
  display: block;
}

.index-oa-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b7280;
  text-align: center;
}

.index-gacha-toolbar {
  width: var(--oc-card-w);
  max-width: 100%;
  margin: 16rpx auto 0;
  padding: 0;
  box-sizing: border-box;
}

.index-gacha-toolbar--wide {
  width: 100%;
  max-width: 100%;
}

.index-home-header {
  margin-bottom: 8rpx;
}

.index-home-title-float {
  margin-top: 80px;
}

.index-home-header .index-gacha-toolbar {
  margin-top: calc(16rpx - 80px);
}

.index-gacha-btn-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 100px;
}

.index-gacha-btn {
  flex: 1;
  min-width: 0;
  padding: 20rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid var(--theme-border);
  box-shadow: 0 6rpx 18rpx var(--theme-shadow-sm);
  box-sizing: border-box;
}

.index-gacha-btn-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  font-weight: 400;
  color: #a8a8b3;
  line-height: 1.35;
}

.index-pools-guide {
  width: 100%;
  margin-bottom: 15px;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.index-pools-guide-text {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.index-pools-guide-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--theme-fill-strong);
  border: 1rpx solid var(--theme-solid-soft-border);
  box-shadow: 0 4rpx 12rpx var(--theme-shadow-sm);
  flex-shrink: 0;
}

.index-pools-guide-btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.35;
}

.index-scope-panel {
  width: 100%;
  padding: 18rpx 20rpx 16rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  background: #ffffff;
  opacity: 1;
  border: 1rpx solid var(--theme-border);
  box-shadow: 0 6rpx 18rpx var(--theme-shadow-sm);
  box-sizing: border-box;
}

.index-scope-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.index-scope-panel-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #a8a8b3;
}

.index-scope-panel-close {
  font-size: 22rpx;
  font-weight: 400;
  color: #b8b8c3;
  padding: 4rpx 0 4rpx 12rpx;
}

.index-scope-field {
  position: relative;
  width: 100%;
  background-color: #ffffff;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid var(--theme-border-soft);
  overflow: hidden;
  box-sizing: border-box;
}

.index-scope-input {
  width: 100%;
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  background: #ffffff;
  border: none;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--diffuse-text, #374151);
  line-height: 1.5;
  text-align: left;
  box-sizing: border-box;
}

.index-scope-placeholder {
  color: #c5c5cf;
  font-weight: 400;
  text-align: left;
}

.index-scope-input--area {
  display: block;
  height: 168rpx;
  min-height: 168rpx;
  max-height: 168rpx;
  padding: 14rpx 96rpx 56rpx 16rpx;
  overflow-y: auto;
  word-break: break-all;
}

.index-scope-inline-btn {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--theme-fill-solid);
  box-shadow: 0 4rpx 12rpx var(--theme-border-mid);
  z-index: 2;
}

.index-scope-inline-btn--applied {
  background: var(--theme-fill-solid-dim);
  box-shadow: none;
}

.index-scope-inline-btn--disabled {
  opacity: 0.55;
}

.index-scope-inline-btn-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.35;
}

/* 第三环节：牌内行高与第一、二环节一致 */
.oc-result-card .attitude-row {
  padding: 3rpx 0;
}

.oc-result-card .attitude-row .label {
  width: 72rpx;
  font-size: 22rpx;
  padding-top: 4rpx;
}

.oc-result-card .attitude-event {
  font-size: 20rpx;
  line-height: 1.3;
}

.oc-result-card .attitude-input {
  height: 44rpx;
  font-size: 24rpx;
}

.oc-result-card .attitude-row .row-lock {
  width: 48rpx;
  height: 48rpx;
  margin-top: 0;
}

.page.oc-page--gacha .oc-gacha-stage,
.page.oc-page--gacha .oc-gacha-card-slot {
  overflow: visible;
}

/* 三环节容器：替代 block，保证 flex 子项能正确撑开卡牌区 */
.gacha-phase-pane {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  width: 100%;
}

.gacha-phase-pane .oc-gacha-stage {
  flex: 1;
  min-height: calc(var(--oc-card-h) + 120rpx);
  padding-top: 8rpx;
  padding-bottom: 72rpx;
}

.gacha-phase-pane .oc-gacha-tap-cover {
  z-index: 50;
}

.page.oc-page--gacha.has-tab-bar .oc-page-shell {
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding-top: 0;
}
