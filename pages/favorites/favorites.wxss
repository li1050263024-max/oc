/* 我的收藏 - 渐变弥散风格 */
.page {
  min-height: 100vh;
  position: relative;
  padding: 40rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.main {
  position: relative;
  z-index: 1;
}

.title-wrap {
  margin-bottom: 40rpx;
}
.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: var(--diffuse-text);
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.item {
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}

.item-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--theme-border-faint);
}
.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--diffuse-highlight);
}
.item-race {
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}

.item-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.item-row .label {
  width: 72rpx;
  flex-shrink: 0;
  color: var(--diffuse-subtle);
}
.item-row .value {
  flex: 1;
  color: var(--diffuse-text);
}
.item-row.item-section {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--theme-border-faint);
}
.item-row.item-bio-hint .bio-preview {
  color: var(--diffuse-highlight, #6d28d9);
  font-size: 24rpx;
}
.btn-bio {
  border-color: var(--theme-border-bold);
}

.item-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.btn-small {
  min-width: 120rpx;
  height: 56rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-shadow: var(--glass-shadow);
}
.btn-small-text {
  font-size: 24rpx;
  color: inherit;
}
.btn-del .btn-small-text {
  color: var(--diffuse-subtle);
}
.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--diffuse-accent);
  border: none;
  box-shadow: 0 12rpx 32rpx var(--theme-fill-mid3);
}
.btn-back .btn-small-text {
  color: #fff;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
.empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--diffuse-subtle);
  margin-bottom: 32rpx;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
