.page {
  min-height: 100vh;
  box-sizing: border-box;
}
.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}
.lead {
  display: block;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
  margin-bottom: 24rpx;
}
.section-card {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
}
.preview-row {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}
.mini-char {
  position: relative;
  width: 72rpx;
  height: 72rpx;
}
.mini-face {
  width: 72rpx;
  height: 72rpx;
  background: #f0dcd0;
  border-radius: 50%;
  border: 1rpx solid var(--pixel-border);
}
.mini-hair {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 64rpx;
  height: 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  border: 1rpx solid var(--pixel-border);
}
.mini-eyes {
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 72rpx;
  display: flex;
  justify-content: space-evenly;
}
.mini-eye {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.08);
}
.form-row.block {
  flex-direction: column;
  align-items: stretch;
}
.form-row.block .form-label {
  width: auto;
  margin-bottom: 8rpx;
}
.form-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--diffuse-text);
  min-height: 56rpx;
}
.form-input.sub {
  margin-top: 8rpx;
}
.form-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.5;
}
.att-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.08);
}
.bio-preview {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--diffuse-text);
  white-space: pre-wrap;
}
.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.action-bar .pixel-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}
.btn-t {
  font-size: 28rpx;
  color: inherit;
}
.btn-ghost .btn-t {
  color: var(--diffuse-text);
}
.bottom-spacer {
  height: 80rpx;
}
