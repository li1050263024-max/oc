.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: transparent;
  position: relative;
}
.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.fam-list-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.fam-list-inner {
  padding: 200rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.fam-hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.fam-hero-top {
  margin-bottom: 28rpx;
}

.fam-hero-titles {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fam-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2f2750;
  letter-spacing: 1rpx;
}

.fam-hero-sub {
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.55);
  line-height: 1.45;
}

.fam-create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5b4b8a, #6d28d9);
  box-shadow: 0 10rpx 24rpx rgba(109, 40, 217, 0.22);
}

.fam-create-plus {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

.fam-create-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.fam-list-empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.fam-list-empty-text {
  font-size: 26rpx;
  color: rgba(60, 48, 96, 0.55);
  line-height: 1.55;
}

.fam-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  backdrop-filter: blur(24rpx);
}

.fam-card--pinned {
  border-color: rgba(109, 40, 217, 0.35);
  box-shadow: 0 8rpx 22rpx rgba(109, 40, 217, 0.12);
}

.fam-card-head {
  margin-bottom: 16rpx;
}

.fam-card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.fam-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f2750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.oc-badge--pin {
  color: #6d28d9;
  background: rgba(109, 40, 217, 0.12);
  border: 1rpx solid rgba(109, 40, 217, 0.22);
}

.fam-card-count {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(60, 48, 96, 0.5);
}

.fam-member-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.fam-member-cell {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.fam-member-cell--dragging {
  opacity: 0.72;
  transform: scale(1.06);
  z-index: 2;
}

.fam-member-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--glass-border);
}

.fam-member-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.fam-member-name {
  margin-top: 8rpx;
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #2f2750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fam-members-empty {
  padding: 20rpx 8rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(60, 48, 96, 0.5);
  line-height: 1.45;
}

.nb-card-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.nb-card-quick-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nb-quick-btn.oc-chip-btn {
  flex: none;
  min-width: 0;
  min-height: 52rpx;
  padding: 6rpx 18rpx;
}

.nb-quick-btn .oc-chip-btn-text {
  font-size: 22rpx;
}

.nb-card-chevron-wrap {
  flex-shrink: 0;
  padding: 12rpx;
  box-sizing: content-box;
}

.nb-card-chevron {
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-right: 4rpx solid var(--theme-chip-border);
  border-bottom: 4rpx solid var(--theme-chip-border);
  transform: rotate(-45deg);
}

.nb-card-chevron--open {
  transform: rotate(45deg);
}

.nb-card-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--theme-border);
}

.nb-card-actions .nb-action-btn.oc-chip-btn {
  width: 100%;
  min-height: 56rpx;
  padding: 6rpx 4rpx;
}

.nb-card-actions .oc-chip-btn-text {
  font-size: 22rpx;
}
