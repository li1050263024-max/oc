.backup-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx 0;
}

.backup-head {
  margin-bottom: 20rpx;
}

.backup-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--theme-ink, #2a2140);
  margin-bottom: 8rpx;
}

.backup-sub {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--diffuse-highlight, #6b6280);
}

.backup-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.backup-action {
  flex: 0 0 auto;
}

.backup-loading,
.backup-empty {
  margin-top: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--diffuse-highlight, #6b6280);
}

.backup-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
  font-size: 26rpx;
}

.backup-list {
  flex: 1;
  height: 0;
  min-height: 0;
}

.backup-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.backup-card--deleted {
  background: rgba(198, 40, 40, 0.06);
  border-color: rgba(198, 40, 40, 0.18);
}

.backup-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.backup-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.backup-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--theme-ink, #2a2140);
}

.backup-meta {
  font-size: 22rpx;
  color: var(--diffuse-highlight, #6b6280);
}

.backup-status {
  font-size: 22rpx;
  color: #3d6b4f;
}

.backup-status--del {
  color: #c62828;
}

.backup-restore {
  flex-shrink: 0;
}

.backup-footer-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
