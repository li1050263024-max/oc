.page {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: transparent;
}

.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.oc-page-shell.bio-shell {
  flex: 1;
  min-height: 0;
  padding: 12rpx 20rpx 0;
  box-sizing: border-box;
}

.bio-panel {
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.bio-inner {
  padding: 20rpx 20rpx 8rpx;
  box-sizing: border-box;
}

.scroll-bottom {
  height: 24rpx;
}

.lead {
  display: block;
  width: 100%;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.section-card {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 24rpx 20rpx 28rpx;
  box-sizing: border-box;
  border: var(--oc-card-border);
  border-radius: var(--oc-card-radius);
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-card--hints {
  background: rgba(255, 255, 255, 0.5) !important;
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-color: var(--theme-border-mid);
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 8rpx;
}

.field-label--sub {
  margin-top: 20rpx;
}

.field-hint {
  display: block;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.hints-area {
  display: block;
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.35);
  border: 1rpx solid var(--theme-border-mid);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.extra-area {
  min-height: 240rpx;
  margin-bottom: 24rpx;
}

.bio-edit-area {
  min-height: 360rpx;
  margin-bottom: 12rpx;
}

.gen-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
}

.gen-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: inherit;
}

.out-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
}

.bio-text {
  display: block;
  width: 100%;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 24rpx;
}

.bio-unsaved-hint {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.result-actions--three {
  flex-wrap: wrap;
}

.result-actions--three .result-btn {
  flex: 1 1 28%;
  min-width: 160rpx;
}

.result-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
}

.result-btn--saved {
  opacity: 0.65;
}

.copy-btn .gen-btn-text {
  color: var(--diffuse-text);
}
