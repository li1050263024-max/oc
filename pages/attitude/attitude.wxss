.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

/* 第三环节：牌内行高与第一、二环节一致，避免撑破固定牌面 */
.oc-result-card .attitude-row {
  padding: 3rpx 0;
}

.oc-result-card .attitude-row .label {
  width: 72rpx;
  font-size: 22rpx;
  padding-top: 4rpx;
}

.oc-result-card .attitude-event {
  font-size: 20rpx;
  line-height: 1.3;
}

.oc-result-card .attitude-input {
  height: 44rpx;
  font-size: 24rpx;
}

.oc-result-card .attitude-row .row-lock {
  width: 48rpx;
  height: 48rpx;
  margin-top: 0;
}

/* 第三环节：按钮区宽于卡牌，允许两侧略超出卡宽 */
.page.oc-page--gacha .oc-gacha-stage,
.page.oc-page--gacha .oc-gacha-card-slot {
  overflow: visible;
}
