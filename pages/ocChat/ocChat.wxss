.page {
  height: 100vh;
  box-sizing: border-box;
}
.bg-solid {
  position: fixed;
  inset: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}
.layout {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100vh;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  gap: 12rpx;
}
.oc-panel {
  width: 168rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  overflow: hidden;
}
.panel-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  padding: 16rpx 12rpx 8rpx;
  text-align: center;
}
.oc-scroll {
  flex: 1;
  min-height: 0;
}
.oc-item {
  padding: 18rpx 12rpx;
  border-top: 1rpx solid rgba(139, 92, 246, 0.08);
}
.oc-item-active {
  background: rgba(167, 139, 250, 0.15);
}
.oc-item-name {
  font-size: 24rpx;
  color: var(--diffuse-text);
  line-height: 1.35;
  word-break: break-all;
}
.oc-empty {
  padding: 20rpx 12rpx;
  font-size: 22rpx;
  color: var(--diffuse-subtle);
  line-height: 1.45;
}
.chat-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(24rpx);
  overflow: hidden;
}
.chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.1);
}
.chat-with {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--diffuse-text);
}
.chat-clear {
  font-size: 24rpx;
  color: var(--diffuse-highlight);
}
.chat-scroll {
  flex: 1;
  min-height: 0;
}
.chat-inner {
  padding: 16rpx 20rpx;
}
.msg-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  padding: 40rpx 0;
}
.msg-row {
  display: flex;
  margin-bottom: 16rpx;
}
.msg-user {
  justify-content: flex-end;
}
.msg-assistant {
  justify-content: flex-start;
}
.msg-bubble {
  max-width: 85%;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}
.msg-user .msg-bubble {
  background: var(--diffuse-accent);
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.msg-assistant .msg-bubble {
  background: var(--glass-bg);
  color: var(--diffuse-text);
  border: 1rpx solid var(--glass-border);
  border-bottom-left-radius: 6rpx;
}
.chat-anchor {
  height: 2rpx;
}
.composer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid rgba(139, 92, 246, 0.1);
}
.composer-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 36rpx;
  border: 1rpx solid var(--glass-border);
}
.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
}
.send-btn.disabled {
  opacity: 0.5;
}
.send-t {
  font-size: 28rpx;
  color: #fff;
}
