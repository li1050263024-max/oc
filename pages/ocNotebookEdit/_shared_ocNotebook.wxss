.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: transparent;
}
.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.notebook-shell {
  padding-bottom: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.notebook-toolbar-float {
  position: fixed;
  left: 28rpx;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  pointer-events: none;
}

.notebook-toolbar-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 100%;
  pointer-events: auto;
}

.notebook-tool-btn.oc-chip-btn {
  flex: none;
  min-width: 0;
  min-height: 0;
  height: 100%;
  padding: 0 18rpx;
  border-radius: 999rpx;
}

.notebook-tool-btn--danger.oc-chip-btn {
  color: #c62828;
}

.notebook-tool-btn--disabled {
  opacity: 0.45;
}

.notebook-tool-btn .oc-chip-btn-text {
  font-size: 22rpx;
}

.notebook-panel {
  flex: 1;
  min-height: 0;
  height: 0 !important;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.notebook-panel-inner {
  min-height: 100%;
  padding: 0 0 24rpx;
  box-sizing: border-box;
}

.nb-backup-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--theme-border-faint);
  border: 1rpx solid var(--theme-border-mid);
}
.nb-backup-tip-text {
  display: block;
  font-size: 24rpx;
  color: var(--diffuse-highlight);
  line-height: 1.55;
}
.card-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* 设定本卡片：透明底 50% */
.nb-card,
.nb-card-add,
.section-card {
  background: rgba(255, 255, 255, 0.5);
}
.nb-card {
  padding: 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}
.nb-card-oc--selected {
  border-color: var(--theme-accent, #5c6bc0);
  box-shadow: 0 0 0 2rpx rgba(92, 107, 192, 0.25);
}
.nb-manage-check {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 4rpx;
}
.nb-manage-check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--theme-border-bold);
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.nb-manage-check-box--on {
  border-color: var(--theme-accent, #5c6bc0);
  background: var(--theme-accent, #5c6bc0);
}
.nb-manage-check-mark {
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
  font-weight: 700;
}
.nb-card-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  border-style: dashed;
  border-color: var(--theme-border-bold);
}
.add-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 300;
  color: var(--diffuse-highlight);
  border-radius: 50%;
  border: 2rpx solid var(--theme-border-bold);
  margin-bottom: 16rpx;
}
.add-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
}
.add-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}
.oc-card-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--theme-border-soft);
}
.oc-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
}
.oc-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.oc-thumb-img {
  width: 100%;
  height: 100%;
}
.oc-card-head {
  flex: 1;
  min-width: 0;
}
.oc-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
}
.oc-race {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}

.oc-basic-rows {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.oc-row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.45;
}
.oc-label {
  width: 72rpx;
  flex-shrink: 0;
  color: var(--diffuse-subtle);
}
.oc-val {
  flex: 1;
  color: var(--diffuse-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.oc-tap-hint-row {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.oc-tap-hint {
  max-width: 168rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--theme-highlight-soft);
  text-align: right;
}

.oc-tap-hint-arrow {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--theme-highlight-soft);
  border-bottom: 3rpx solid var(--theme-highlight-soft);
  transform: rotate(-45deg);
}

.nb-card-body {
  display: block;
  position: relative;
}

.nb-card-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.nb-card-title-row .oc-card-top {
  flex: 1;
  min-width: 0;
}

.nb-card-footer-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.nb-card-chevron-wrap {
  flex-shrink: 0;
  padding: 12rpx;
  box-sizing: content-box;
}

.nb-card-chevron {
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-right: 4rpx solid var(--theme-chip-border);
  border-bottom: 4rpx solid var(--theme-chip-border);
  transform: rotate(45deg);
}

.nb-card-chevron--open {
  transform: rotate(-135deg);
}

.nb-card-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--theme-border);
}

.nb-card-actions .nb-action-btn.oc-chip-btn {
  width: 100%;
  min-height: 56rpx;
  padding: 6rpx 4rpx;
}

.nb-card-actions .oc-chip-btn-text {
  font-size: 22rpx;
}
.empty-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  line-height: 1.5;
}
.bottom-spacer {
  height: 0;
}

/* 详情页共用 */
.section-card {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
}
.oc-image-block {
  margin-bottom: 20rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--theme-border-faint);
}
.oc-image-label {
  font-size: 26rpx;
  color: var(--diffuse-subtle);
  margin-bottom: 12rpx;
}
.oc-image-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
  margin-bottom: 16rpx;
}
.oc-image-img {
  width: 100%;
  height: 100%;
  display: block;
}
.oc-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx dashed var(--theme-border-strong);
}
.oc-image-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
}
.oc-image-actions {
  display: flex;
  gap: 16rpx;
}
.oc-image-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--theme-border-faint);
}
.form-row.block {
  flex-direction: column;
  align-items: stretch;
}
.form-row.block .form-label {
  width: auto;
  margin-bottom: 8rpx;
}
.form-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--diffuse-text);
  min-height: 56rpx;
}
.form-input.sub {
  margin-top: 8rpx;
}
.form-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: var(--diffuse-text);
  line-height: 1.5;
}
.att-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--theme-border-faint);
}
.bio-preview {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--diffuse-text);
  white-space: pre-wrap;
}
.action-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 8rpx;
}
.action-bar .pixel-btn {
  width: 100%;
  min-height: 64rpx;
  height: auto;
  padding: 10rpx 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  box-sizing: border-box;
}
.action-bar .btn-t {
  font-size: 24rpx;
  text-align: center;
  line-height: 1.3;
}
.btn-t {
  font-size: 28rpx;
  color: inherit;
}
.btn-ghost .btn-t {
  color: var(--diffuse-text);
}
.save-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
  text-align: center;
  line-height: 1.5;
}
