@import './_shared_ocNotebook.wxss';

.edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}
.edit-page .bg-solid {
  pointer-events: none;
}
.edit-body {
  position: relative;
  z-index: 1;
  padding: calc(env(safe-area-inset-top) + 88rpx) 28rpx 48rpx;
  box-sizing: border-box;
}
.auto-parse-card {
  margin-bottom: 24rpx;
}
.auto-parse-hint {
  display: block;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
  line-height: 1.55;
  margin-bottom: 16rpx;
}
.auto-parse-input {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--diffuse-text);
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.auto-parse-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}
.auto-parse-btn.disabled {
  opacity: 0.55;
}

.oc-image-swiper-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
}
.oc-image-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.oc-image-expand-btn {
  font-size: 24rpx;
  color: var(--diffuse-highlight);
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--theme-border);
}
.oc-image-preview {
  position: relative;
  width: 100%;
  height: 100%;
  margin-bottom: 0;
  border-radius: 0;
  border: none;
  background: transparent;
}
.oc-image-expand-hint {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
}
.oc-image-expand-hint-text {
  font-size: 22rpx;
  color: #ffffff;
}
.oc-image-swiper {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}
.oc-image-block .oc-image-placeholder {
  aspect-ratio: 3 / 4;
  width: 100%;
  min-height: 520rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.oc-image-count {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
}

.oc-image-fullscreen {
  position: fixed;
  inset: 0;
  z-index: 600;
}
.oc-image-fullscreen-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.94);
}
.oc-image-fullscreen-panel {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
}
.oc-image-fullscreen-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 12rpx;
  gap: 16rpx;
}
.oc-image-fullscreen-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}
.oc-image-fullscreen-count {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}
.oc-image-fullscreen-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.14);
}
.oc-image-fullscreen-close-icon {
  font-size: 44rpx;
  line-height: 1;
  color: #ffffff;
  margin-top: -4rpx;
}
.oc-image-fullscreen-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}
.oc-image-fullscreen-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}
.oc-image-fullscreen-img {
  width: 100%;
  height: 100%;
  display: block;
}
.oc-image-fullscreen-tip {
  flex-shrink: 0;
  padding: 16rpx 28rpx 28rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
}

.btn-danger .btn-t {
  color: #c62828;
}
