.sc-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f7f8;
  color: #161823;
}

.sc-head {
  margin-bottom: 24rpx;
}

.sc-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.sc-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(22, 24, 35, 0.55);
}

.sc-kv {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(22, 24, 35, 0.42);
}

.sc-section {
  margin-bottom: 28rpx;
  padding: 8rpx 0;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}

.sc-sec-title {
  display: block;
  padding: 20rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: rgba(22, 24, 35, 0.45);
}

.sc-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.sc-row--action:active {
  background: rgba(0, 0, 0, 0.03);
}

.sc-row-main {
  flex: 1;
  min-width: 0;
}

.sc-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.sc-row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(22, 24, 35, 0.45);
}

.sc-row-go {
  font-size: 26rpx;
  color: #fe2c55;
  font-weight: 600;
}

.sc-empty {
  padding: 36rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(22, 24, 35, 0.35);
}

.sc-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.sc-item--on {
  background: rgba(254, 44, 85, 0.04);
}

.sc-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(22, 24, 35, 0.22);
  box-sizing: border-box;
  flex-shrink: 0;
}

.sc-check--on {
  border-color: #fe2c55;
  background: #fe2c55;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.sc-item-main {
  flex: 1;
  min-width: 0;
}

.sc-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.sc-item-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(22, 24, 35, 0.42);
}

.sc-tip {
  padding: 8rpx 8rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(22, 24, 35, 0.4);
}

.sc-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.sc-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.sc-btn--ghost {
  background: #f1f1f2;
  color: #161823;
}

.sc-btn--primary {
  background: #fe2c55;
  color: #fff;
}

.sc-btn--disabled {
  opacity: 0.4;
}
