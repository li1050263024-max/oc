.sc-page {
  min-height: 100vh;
  padding: 0 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f5f3ff 0%, #f8f7fc 40%, #f3f0ff 100%);
  color: #1f1635;
}

.sc-nav {
  margin: 0 -28rpx 8rpx;
  background: transparent;
}

.sc-nav-inner {
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 8rpx;
  box-sizing: border-box;
}

.sc-nav-back {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc-nav-back-ico {
  font-size: 52rpx;
  line-height: 1;
  color: #4c1d95;
  font-weight: 300;
  margin-top: -6rpx;
}

.sc-nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #3b2166;
}

.sc-nav-spacer {
  width: 72rpx;
}

.sc-head {
  margin-bottom: 24rpx;
  padding-top: 12rpx;
}

.sc-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4c1d95;
}

.sc-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(55, 35, 90, 0.62);
}

.sc-kv {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 500;
}

.sc-section {
  margin-bottom: 28rpx;
  padding: 8rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(167, 139, 250, 0.28);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(109, 40, 217, 0.06);
}

.sc-sec-title {
  display: block;
  padding: 20rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: rgba(76, 29, 149, 0.55);
  font-weight: 600;
}

.sc-cat {
  padding: 16rpx 24rpx 18rpx;
  border-top: 1rpx solid rgba(167, 139, 250, 0.16);
}

.sc-cat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sc-cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3b2166;
}

.sc-cat-size {
  font-size: 26rpx;
  font-weight: 600;
  color: #6d28d9;
}

.sc-bar {
  margin-top: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(167, 139, 250, 0.22);
  overflow: hidden;
}

.sc-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
}

.sc-cat-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(55, 35, 90, 0.45);
}

.sc-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.sc-row--action:active {
  background: rgba(124, 58, 237, 0.05);
}

.sc-row-main {
  flex: 1;
  min-width: 0;
}

.sc-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3b2166;
}

.sc-row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(55, 35, 90, 0.48);
}

.sc-row-go {
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 600;
}

.sc-empty {
  padding: 36rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(55, 35, 90, 0.35);
}

.sc-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-top: 1rpx solid rgba(167, 139, 250, 0.16);
}

.sc-item--on {
  background: rgba(124, 58, 237, 0.06);
}

.sc-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(124, 58, 237, 0.35);
  box-sizing: border-box;
  flex-shrink: 0;
}

.sc-check--on {
  border-color: #7c3aed;
  background: #7c3aed;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.sc-item-main {
  flex: 1;
  min-width: 0;
}

.sc-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #3b2166;
}

.sc-item-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(55, 35, 90, 0.45);
}

.sc-tip {
  padding: 8rpx 8rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(55, 35, 90, 0.42);
}

.sc-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(167, 139, 250, 0.22);
  box-sizing: border-box;
}

.sc-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.sc-btn--ghost {
  background: #efe9ff;
  color: #5b21b6;
}

.sc-btn--primary {
  background: linear-gradient(135deg, #8b5cf6, #6d28d9);
  color: #fff;
}

.sc-btn--disabled {
  opacity: 0.4;
}
