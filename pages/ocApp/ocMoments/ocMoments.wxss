.page.oc-page.has-tab-bar {
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.page.has-tab-bar .moments-scroll {
  flex: 1;
  min-height: 0;
  height: 0 !important;
  box-sizing: border-box;
}

.page.has-tab-bar .scroll-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.moments-scroll {
  position: relative;
  z-index: 1;
}

.scroll-inner {
  box-sizing: border-box;
}

.moments-cover {
  position: relative;
  height: calc(520rpx + env(safe-area-inset-top));
  overflow: visible;
}

.moments-cover-img,
.moments-cover-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.moments-cover-bg {
  background: var(--theme-gradient-primary-3);
}

.moments-cover-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.28));
}

.moments-cover-back {
  position: absolute;
  left: 16rpx;
  bottom: 36rpx;
  z-index: 3;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.moments-cover-back-chevron {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.moments-camera-btn {
  /* 相对封面定位；right 固定，勿用 JS 按胶囊算横向，避免漂移到左侧 */
  position: absolute;
  right: 28rpx;
  z-index: 110;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.moments-camera-icon {
  width: 40rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-radius: 8rpx;
  box-sizing: border-box;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.moments-camera-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin: -7rpx 0 0 -7rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.moments-camera-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: -8rpx;
  width: 14rpx;
  height: 8rpx;
  border: 3rpx solid #fff;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  box-sizing: border-box;
}

.moments-cover-profile {
  position: absolute;
  right: 28rpx;
  bottom: -40rpx;
  z-index: 4;
  display: flex;
  align-items: flex-end;
}

.moments-cover-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  background: #e5e7eb;
  box-sizing: border-box;
}

.moments-cover-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c4b5fd;
}

.moments-cover-avatar-letter {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.moments-body {
  flex: 1;
  margin-top: -24rpx;
  padding-top: 56rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx 24rpx 0 0;
}

.moments-notify-slot {
  min-height: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx 32rpx 20rpx;
  box-sizing: border-box;
}

.moments-publish-btn {
  display: inline-flex;
}

.moments-loading {
  padding: 100rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.moments-loading-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(124, 58, 237, 0.2);
  border-top-color: var(--theme-accent-deep);
  animation: moments-spin 0.8s linear infinite;
}

@keyframes moments-spin {
  to {
    transform: rotate(360deg);
  }
}

.moments-loading-text {
  font-size: 28rpx;
  color: var(--theme-accent-deep);
}

.moments-empty {
  padding: 80rpx 48rpx;
  text-align: center;
}

.moments-empty-text {
  font-size: 28rpx;
  color: #6b7280;
}

.moment-item {
  padding: 28rpx 32rpx 0;
}

.moment-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.moment-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--oc-card-face-bg);
}

.moment-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-gradient-soft);
}

.moment-avatar--user {
  background: linear-gradient(145deg, #93c5fd, #60a5fa);
}

.moment-avatar-letter {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.moment-meta {
  flex: 1;
  min-width: 0;
}

.moment-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #576b95;
}

.moment-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.moment-content {
  margin: 16rpx 0 0 104rpx;
}

.moment-text {
  font-size: 30rpx;
  line-height: 1.65;
  color: #1f2937;
  word-break: break-word;
}

.moment-imgs {
  margin: 16rpx 0 0 104rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.moment-img {
  border-radius: 12rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.moment-img--n1 {
  width: 420rpx;
  height: 420rpx;
}

.moment-img--n2 {
  width: 270rpx;
  height: 270rpx;
}

.moment-img--n3 {
  width: 176rpx;
  height: 176rpx;
}

.moment-actions {
  margin: 16rpx 0 0 104rpx;
