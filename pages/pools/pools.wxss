/* 选项库 - 渐变弥散风格 */

.page {
  min-height: 100vh;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx 0;
  box-sizing: border-box;
  background: transparent;
}



.bg-solid {

  position: fixed;

  left: 0;

  top: 0;

  right: 0;

  bottom: 0;

  background: var(--diffuse-bg);

  z-index: 0;

}



.main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
  box-sizing: border-box;
}

.title-wrap {

  margin-bottom: 24rpx;

  flex-shrink: 0;
  padding-left: 88rpx;
  box-sizing: border-box;

}

.title {

  display: block;

  font-size: 44rpx;

  font-weight: 600;

  color: var(--diffuse-text);

  margin-bottom: 8rpx;

}

.subtitle {

  font-size: 26rpx;

  color: var(--diffuse-subtle);

}



.batch-toolbar-wrap {

  position: relative;

  z-index: 10;

  flex-shrink: 0;

  margin-bottom: 16rpx;

}

.batch-toolbar {

  display: flex;

  align-items: center;

  justify-content: space-between;

  min-height: 88rpx;

  padding: 0 28rpx;

  border-radius: 16rpx;

  border: 1rpx solid rgba(255, 255, 255, 0.35);

  background: rgba(255, 255, 255, 0.5);

  backdrop-filter: blur(24rpx);

  -webkit-backdrop-filter: blur(24rpx);

  box-shadow: var(--glass-shadow);

}

.batch-toolbar--on {

  border-color: rgba(124, 58, 237, 0.45);

  background: var(--theme-fill-soft2);

}

.batch-toolbar-hover {

  opacity: 0.88;

}

.batch-toolbar-title {

  font-size: 30rpx;

  font-weight: 600;

  color: var(--diffuse-highlight);

}

.batch-toolbar-state {

  font-size: 26rpx;

  color: var(--diffuse-accent);

  font-weight: 500;

}

.batch-bar {

  display: flex;

  flex-wrap: wrap;

  gap: 12rpx;

  margin-top: 12rpx;

}

.batch-bar-btn {

  flex: 1;

  min-width: 28%;

  height: 64rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 12rpx;

  border: 1rpx solid var(--glass-border);

  background: rgba(255, 255, 255, 0.55);

}

.batch-bar-btn text {

  font-size: 24rpx;

  color: var(--diffuse-text);

}

.batch-bar-btn-hover {

  opacity: 0.85;

}

.batch-bar-btn-danger text {

  color: #b45309;

}

.batch-bar-btn-disabled {

  opacity: 0.45;

}



.sections {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.section-tools {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--theme-border);
}

.item-list-scroll {
  width: 100%;
  max-height: none;
  margin-top: 8rpx;
  box-sizing: border-box;
}



.section {

  padding: 20rpx 24rpx;

  margin-bottom: 20rpx;

  border: 1rpx solid rgba(255, 255, 255, 0.35);

  border-radius: 16rpx;

  background: rgba(255, 255, 255, 0.5);

  backdrop-filter: blur(24rpx);

  -webkit-backdrop-filter: blur(24rpx);

  box-shadow: var(--glass-shadow);

}



.section-header {

  display: flex;

  align-items: center;

  gap: 12rpx;

}

.section-header-main {

  flex: 1;

  min-width: 0;

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 8rpx 12rpx;

}

.section-title {

  font-size: 30rpx;

  font-weight: 600;

  color: var(--diffuse-highlight);

}

.section-count {

  font-size: 22rpx;

  color: var(--diffuse-subtle);

}

.section-tag {

  font-size: 20rpx;

  color: var(--diffuse-subtle);

  padding: 4rpx 12rpx;

  border-radius: 12rpx;

  background: var(--theme-fill-soft2);

}

.section-fold {

  flex-shrink: 0;

  width: 56rpx;

  height: 56rpx;

  display: flex;

  align-items: center;

  justify-content: center;

}

.section-fold-hover {

  opacity: 0.75;

}



.fold-tri {

  width: 0;

  height: 0;

  border-left: 12rpx solid transparent;

  border-right: 12rpx solid transparent;

  border-top: 14rpx solid var(--diffuse-highlight);

  transition: transform 0.2s ease;

  transform: rotate(-90deg);

}

.fold-tri--open {

  transform: rotate(0deg);

}

.fold-tri--sm {

  border-left-width: 10rpx;

  border-right-width: 10rpx;

  border-top-width: 12rpx;

}



.pool-check {

  flex-shrink: 0;

  width: 48rpx;

  height: 48rpx;

  display: flex;

  align-items: center;

  justify-content: center;

}

.pool-check--section {

  margin-right: -4rpx;

}

.pool-check-ring {

  width: 36rpx;

  height: 36rpx;

  border-radius: 50%;

  border: 2rpx solid var(--theme-border-heavy);

  background: transparent;

  box-sizing: border-box;

}

.pool-check-ring--on {

  border-color: var(--diffuse-accent);

  background: var(--diffuse-accent);

  box-shadow: inset 0 0 0 6rpx #fff;

}



.item-list {
  padding: 4rpx 8rpx 12rpx 0;
}

.item-empty {

  padding: 24rpx 0;

  font-size: 26rpx;

  color: var(--diffuse-subtle);

  text-align: center;

}

.item-row {

  display: flex;

  align-items: center;

  padding: 14rpx 0;

  border-bottom: 1rpx solid var(--theme-border-faint);

}

.item-row:last-child {

  border-bottom: none;

}

.item-row--hidden .item-text {

  opacity: 0.4;

  text-decoration: line-through;

}

.item-text {

  flex: 1;

  min-width: 0;

  font-size: 28rpx;

  color: var(--diffuse-text);

}

.item-fold {

  flex-shrink: 0;

  width: 48rpx;

  height: 48rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-left: 8rpx;

}

.item-fold-hover {

  opacity: 0.75;

}

.item-del {

  flex-shrink: 0;

  padding: 6rpx 20rpx;

  margin-left: 8rpx;

  font-size: 24rpx;

  color: var(--diffuse-subtle);

  border: 1rpx solid var(--diffuse-border);

  border-radius: 16rpx;

  background: var(--diffuse-card);

  display: flex;

  align-items: center;

  justify-content: center;

}

.item-del-text {

  font-size: 24rpx;

  color: inherit;

}



.ai-row {

  display: flex;

  align-items: center;

  gap: 12rpx;

  margin-top: 16rpx;

}

.ai-theme-input {

  flex: 1;

  min-width: 0;

}

.btn-ai {

  flex-shrink: 0;

  height: 64rpx;

  padding: 0 20rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16rpx;

  background: var(--theme-gradient-primary);

  border: none;

}

.btn-ai-all {

  width: 100%;

  height: 72rpx;

  margin-bottom: 16rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 36rpx;

  background: var(--theme-gradient-primary);

  border: none;

}

.btn-ai-text {

  font-size: 28rpx;

  color: #fff;

}

.btn-ai-disabled {

  opacity: 0.55;

}



.add-row {

  display: flex;

  align-items: center;

  gap: 16rpx;

  margin-top: 16rpx;

}

.add-input {

  flex: 1;

  min-width: 0;

  height: 64rpx;

  padding: 0 20rpx;

  font-size: 28rpx;

  background: var(--glass-bg);

  backdrop-filter: blur(16rpx);

  -webkit-backdrop-filter: blur(16rpx);

  border: 1rpx solid var(--glass-border);

  border-radius: 16rpx;

  color: var(--diffuse-text);

}

.btn-add {

  flex-shrink: 0;

  height: 64rpx;

  padding: 0 28rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16rpx;

  background: var(--diffuse-accent);

  border: none;

  box-shadow: 0 12rpx 32rpx var(--theme-fill-mid3);

}

.btn-add-text {

  font-size: 28rpx;

  color: #fff;

}



.bottom-actions {

  flex-shrink: 0;

  padding-top: 24rpx;

  display: flex;

  flex-direction: column;

  align-items: stretch;

}

.btn-reset {

  min-width: 200rpx;

  height: 72rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 36rpx;

  border: 1rpx solid var(--glass-border);

  background: var(--glass-bg);

  backdrop-filter: blur(24rpx);

  -webkit-backdrop-filter: blur(24rpx);

  box-shadow: var(--glass-shadow);

}

.btn-reset-text {

  font-size: 28rpx;

  color: var(--diffuse-subtle);

}



.safe-bottom {

  padding-bottom: constant(safe-area-inset-bottom);

  padding-bottom: env(safe-area-inset-bottom);

}

