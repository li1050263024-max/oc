/* 自定义选项页 - 渐变弥散风格 */
.page {
  min-height: 100vh;
  position: relative;
  padding: 40rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.bg-solid {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--diffuse-bg);
  z-index: 0;
}

.main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.title-wrap {
  margin-bottom: 32rpx;
  flex-shrink: 0;
}
.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--diffuse-text);
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--diffuse-subtle);
}

.sections {
  flex: 1;
  min-height: 0;
  height: 60vh;
}

.section {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--diffuse-highlight);
  margin-bottom: 20rpx;
}

.item-list {
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.08);
}
.item-row:last-child {
  border-bottom: none;
}
.item-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--diffuse-text);
}
.item-del {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--diffuse-subtle);
  border: 1rpx solid var(--diffuse-border);
  border-radius: 16rpx;
  background: var(--diffuse-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-del-text {
  font-size: 24rpx;
  color: inherit;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.add-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  color: var(--diffuse-text);
}
.btn-add {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--diffuse-accent);
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(167, 139, 250, 0.35);
}
.btn-add-text {
  font-size: 28rpx;
  color: #fff;
}

.bottom-actions {
  flex-shrink: 0;
  padding-top: 32rpx;
  display: flex;
  justify-content: center;
}
.btn-reset {
  min-width: 200rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--glass-shadow);
}
.btn-reset-text {
  font-size: 28rpx;
  color: var(--diffuse-subtle);
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
